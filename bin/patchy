#!/bin/zsh

# Patchy — a patchy little PHP dev server for macOS (running Apache)

set -uo pipefail

# Get the Homebrew installation prefix
BREW_PREFIX="$(brew --prefix)"
export BREW_PREFIX

# Define the directory for Apache virtual hosts
VHOSTS_DIR="$BREW_PREFIX/etc/httpd/sites"
export VHOSTS_DIR

# Define the Apache configuration file path
APACHE_CONFIG="$BREW_PREFIX/etc/httpd/httpd.conf"
export APACHE_CONFIG

# Define the directory for SSL certificates
CERT_DIR="$BREW_PREFIX/etc/httpd/certs"
export CERT_DIR

# Patchy-managed Apache include (rewritten in full by setup and php switch)
PATCHY_CONF="$BREW_PREFIX/etc/httpd/patchy.conf"
export PATCHY_CONF

# Apache log directory
LOG_DIR="$BREW_PREFIX/var/log/httpd"
export LOG_DIR

# Stable share addresses (patchy share setup): Cloudflare login, domain, per-site tunnels
SHARE_DIR="$BREW_PREFIX/etc/httpd/share"
SHARE_USER="preview"

# Default parent directory for new site docroots
DEFAULT_WEBROOT="$HOME/Websites"

# Legacy dnsmasq installs (pre-hosts migration) — referenced only by
# migrate_dnsmasq/legacy_dns_hint so 'setup' can clean them up.
DNSMASQ_PORT=53535
DNSMASQ_DIR="$BREW_PREFIX/etc/dnsmasq.d"
PATCHY_DNS_CONF="$DNSMASQ_DIR/patchy.conf"
RESOLVER_DIR="/etc/resolver"

# 'patchy trust' installs a root-owned helper + sudoers NOPASSWD rule so
# /etc/hosts edits stop prompting for a password. Never point sudoers at
# patchy itself — this script is user-writable, the helper is not.
HELPER_PATH="/usr/local/libexec/patchy-hosts"
SUDOERS_FILE="/etc/sudoers.d/patchy"

# Bumped whenever write_hosts_helper changes what it writes. An installed
# helper predates the change unless 'check' echoes this exact string, and a
# stale helper would keep writing the old entries while patchy assumed the
# new ones — so a mismatch falls back to inline sudo until 'trust' reinstalls.
HELPER_VERSION="2"

# Script name for help text (zsh's $0 resolves to function name inside functions)
SCRIPT_NAME="${0:t}"

# Resolved script path, captured at top level for the same $0 reason
SCRIPT_PATH="${0:A}"

# Version is derived, never stored: brew runs from a versioned Cellar path;
# source installs report git describe from the clone
function patchy_version() {
    case "$SCRIPT_PATH" in
        */Cellar/patchy/*)
            local v="${SCRIPT_PATH#*/Cellar/patchy/}"
            echo "${v%%/*}"
            return 0
            ;;
    esac
    local gitv
    gitv=$(git -C "${SCRIPT_PATH:h}" describe --tags 2>/dev/null)
    if [ -n "$gitv" ]; then
        echo "${gitv#v}"
    else
        echo "dev"
    fi
}

# Path of the most recent httpd.conf backup (set by backup_config)
LAST_BACKUP=""

# Function to display help message
function show_help() {
    cat <<EOF
Patchy v$(patchy_version) — a patchy little PHP dev server for macOS (running Apache)

Usage: $SCRIPT_NAME {command} [options]

Commands:
  help                Show this help message

  list                List the sites configured on the Apache server
  add <domain> [dir]  Add a new site (docroot defaults to ~/Websites/<domain>)
  rm <domain>...      Remove one or more sites with the specified domains
  share <domain>      Share a site at a public link (needs cloudflared): your own
                      domain once set up, otherwise a temporary link.
                      Options: --quick, --name <word>, --open, --password, --new-password
  share setup <domain>
                      Use your own Cloudflare domain for stable share addresses
  share reset         Stop using your own domain; back to temporary links

  status              Display the status of the Apache server and /etc/hosts routing
  start               Start Apache and route site domains to this Mac (/etc/hosts)
  stop                Stop Apache and release site domains back to public DNS
  restart             Restart the Apache server and repair /etc/hosts routing

  config              Edit the Apache configuration file
  ini                 Edit the PHP configuration file
  check               Verify the Apache and PHP configuration

  info                Display Apache and PHP version information
  version             Display the Patchy version
  php <version>       Switch to the specified PHP version. You must have it installed via Homebrew.
  pecl                Install common PECL extensions (redis, apcu, imagick, yaml, pcov, memcached)
  refresh-certs       Refresh the SSL certificates

  setup               One-time setup: Apache user, ports 80/443, modules, PHP handler, vhost include, DNS
  trust               Let patchy update /etc/hosts without a sudo password
  untrust             Remove the passwordless /etc/hosts helper

  errors [lines|-f]   Display the last [lines] of the Apache error log (default 20), or -f to follow
  logs                Tail the Apache logs
EOF
}

function start_server() {
    echo "Starting Apache server..."
    brew services start httpd
    sync_hosts_entries
    legacy_dns_hint
    if ! wait_for_apache; then
        echo "Warning: Apache did not start."
        diagnose_startup_failure
        return 1
    fi
}

# brew services returns 0 even if launchd fails to bring the process up.
# Give it a moment and verify.
function wait_for_apache() {
    local i
    for i in 1 2 3; do
        sleep 1
        is_apache_running && return 0
    done
    return 1
}

# The httpd LaunchAgent discards stderr, and Apache startup errors raised
# before the error log is opened (ports already taken, unwritable log dir)
# only ever go to stderr — so this whole class of failure leaves no trace
# in 'patchy errors'. Re-run httpd attached to a pipe to surface the real
# error; if it comes up fine that way, the launchd job itself is wedged.
function diagnose_startup_failure() {
    local httpd_bin="$BREW_PREFIX/opt/httpd/bin/httpd"
    local out pid i
    if [ ! -x "$httpd_bin" ] || ! out=$(mktemp); then
        echo "Run '$SCRIPT_NAME errors' to see what went wrong."
        return 0
    fi
    "$httpd_bin" -D FOREGROUND >"$out" 2>&1 &
    pid=$!
    for i in 1 2 3; do
        sleep 1
        kill -0 "$pid" 2>/dev/null || break
    done
    if kill -0 "$pid" 2>/dev/null; then
        # Survived: Apache itself is fine, so the launchd job is stuck
        # (loaded but dead — bootstrapping it again fails with error 5).
        # A stop boots the job out; the next start reloads it clean.
        kill "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        echo "Apache starts fine when run directly — the launchd service is stuck."
        echo "Run '$SCRIPT_NAME stop' and then '$SCRIPT_NAME start' to reset it."
    elif [ -s "$out" ]; then
        wait "$pid" 2>/dev/null
        echo "Apache's startup error:"
        sed 's/^/  /' "$out"
        if grep -q "Address already in use" "$out"; then
            # One line per listening process name — prefork spawns dozens of
            # identical workers and listing them all buries the answer.
            local holders
            holders=$(lsof -nP -iTCP:80 -iTCP:443 -sTCP:LISTEN 2>/dev/null | awk 'NR == 1 || !seen[$1]++')
            if [ -n "$holders" ]; then
                echo "Something else is listening on port 80/443:"
                echo "$holders" | sed 's/^/  /'
            else
                echo "Run 'sudo lsof -nP -iTCP:80 -iTCP:443 -sTCP:LISTEN' to see"
                echo "what is holding ports 80/443."
            fi
        fi
    else
        wait "$pid" 2>/dev/null
        echo "Run '$SCRIPT_NAME errors' to see what went wrong."
    fi
    rm -f "$out"
}

function stop_server() {
    echo "Stopping Apache server..."
    brew services stop httpd
    if hosts_active; then
        hosts_sudo_note
        if hosts_sync; then
            echo "Released site domains back to public DNS."
        else
            echo "Warning: /etc/hosts entries were not removed; site domains still" >&2
            echo "resolve to this Mac. Run '$SCRIPT_NAME stop' again to retry." >&2
        fi
    fi
}

# /etc/hosts is the DNS layer: one marked line per configured site, applied
# by macOS immediately — no daemon, no cache flush, no stale TTLs.
function sync_hosts_entries() {
    [ -n "$(list_domains)" ] || return 0
    hosts_sudo_note
    if ! hosts_sync $(list_hosts_names); then
        echo "Warning: /etc/hosts was not updated — sites will not resolve locally." >&2
        echo "Run '$SCRIPT_NAME start' again to retry." >&2
        return 1
    fi
}

# Old installs routed DNS through dnsmasq via /etc/resolver files on our
# port. /etc/hosts wins for configured names, but leftovers break other
# lookups under those TLDs/domains — setup cleans them up.
function legacy_dns_hint() {
    local f
    for f in "$RESOLVER_DIR"/*(N); do
        if grep -qE "^port[[:space:]]+$DNSMASQ_PORT\$" "$f" 2>/dev/null; then
            echo "Note: legacy dnsmasq resolver files found in $RESOLVER_DIR — run"
            echo "'$SCRIPT_NAME setup' to finish migrating to /etc/hosts routing."
            return 0
        fi
    done
    return 0
}

function is_apache_running() {
    brew services info httpd --json | jq -e '.[0].running' >/dev/null 2>&1
}

function restart_server() {
    echo "Restarting Apache server..."
    brew services restart httpd
    sync_hosts_entries
    wait_for_apache && return 0
    echo "Warning: Apache did not come back up after restart."
    diagnose_startup_failure
    return 1
}

# macOS caches DNS answers with their original TTLs; a routing change
# (resolver file added or removed) doesn't purge them, so a just-added
# domain can keep resolving to its live IP for minutes without this.
function flush_dns_cache() {
    echo "Flushing macOS DNS cache..."
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder
}

# Every site lives in /etc/hosts as an exact name with a trailing "# patchy"
# marker, so patchy can rewrite its own entries without touching anything
# else. (.local names are Bonjour-safe here — exact hosts entries don't
# capture the TLD the way a resolver file would.)
#
# Both an IPv4 and an IPv6 line, always. Browsers resolve with AF_UNSPEC and
# wait for the A *and* AAAA answers before connecting. A .local name with only
# a 127.0.0.1 line answers the A leg from here but leaves the AAAA leg to
# mDNSResponder, which multicasts it to the LAN and waits out the full 5s
# Bonjour timeout — a flat 5s added to every request. The ::1 line answers
# that leg locally so it never reaches multicast.
function hosts_entry_exists() {
    local escaped="${1//./\\.}"
    grep -qE "^127\.0\.0\.1[[:space:]]+${escaped}[[:space:]]*# patchy\$" /etc/hosts &&
        grep -qE "^::1[[:space:]]+${escaped}[[:space:]]*# patchy\$" /etc/hosts
}

function hosts_active() {
    grep -qE '# patchy$' /etc/hosts
}

# Passwordless mode is usable only if the helper exists AND sudo lets us run
# it without a password ('patchy trust' installs both).
function trust_active() {
    [ -x "$HELPER_PATH" ] || return 1
    [ "$(sudo -n "$HELPER_PATH" check 2>/dev/null)" = "$HELPER_VERSION" ]
}

# Installed and callable, but not necessarily the current version. Used to
# tell "never trusted" apart from "trusted, but the helper needs updating".
function trust_installed() {
    [ -x "$HELPER_PATH" ] && sudo -n "$HELPER_PATH" check >/dev/null 2>&1
}

function hosts_sudo_note() {
    trust_active && return 0
    if trust_installed; then
        echo "Password prompt ahead: the patchy-hosts helper is out of date."
        echo "Run '$SCRIPT_NAME trust' once to update it and stop these prompts."
        return 0
    fi
    echo "Password prompt ahead: patchy routes domains via /etc/hosts, which needs"
    echo "sudo. Run '$SCRIPT_NAME trust' once to stop these prompts."
}

# The single /etc/hosts writer: make the "# patchy" lines match exactly the
# given domains. Desired-state (not add/remove deltas) so every caller
# regenerates from the same source of truth. Tries the trust helper first;
# falls back to inline sudo with a normal password prompt.
function hosts_sync() {
    if trust_active && sudo -n "$HELPER_PATH" sync "$@"; then
        return 0
    fi
    hosts_sync_inline "$@"
}

# Inline fallback: rebuild to a temp file, then atomically install over
# /etc/hosts (never truncate-in-place — a half-written hosts file kills all
# name resolution).
function hosts_sync_inline() {
    local domain tmp
    tmp=$(mktemp) || return 1
    {
        grep -v '# patchy$' /etc/hosts
        for domain in "$@"; do
            echo "127.0.0.1 $domain # patchy"
            echo "::1 $domain # patchy"
        done
    } > "$tmp" || { rm -f "$tmp"; return 1; }
    sudo /usr/bin/install -m 644 -o root -g wheel "$tmp" /etc/hosts
    local rc=$?
    rm -f "$tmp"
    return $rc
}

# Sync the configured names ± one site — used by add/rm, where the vhost
# file for the site in question doesn't exist yet / still exists. add
# passes the new domain plus any accepted alias explicitly.
function hosts_add() {
    hosts_sync $(list_hosts_names) "$@"
}

function hosts_remove() {
    local domain=$1 name keep=() drop
    drop=$(echo "$domain"; list_site_aliases "$domain")
    for name in $(list_hosts_names); do
        echo "$drop" | grep -qxF "$name" || keep+=("$name")
    done
    hosts_sync "${keep[@]}"
}

# The helper is the ONLY thing sudoers whitelists, so it must be minimal,
# root-owned, and impossible to talk into editing anything but our marked
# lines. Emitted here so patchy stays a single distributable file.
function write_hosts_helper() {
    # Shebang and version printed separately so HELPER_VERSION interpolates;
    # the body stays in a quoted heredoc so its own $vars reach the helper
    # verbatim rather than being expanded here.
    printf '#!/bin/sh\n'
    printf "# patchy-hosts — installed root-owned by 'patchy trust'.\n"
    printf '# Rewrites the "# patchy" marked lines of /etc/hosts and nothing else.\n'
    printf 'PATCHY_HELPER_VERSION=%s\n' "$HELPER_VERSION"
    cat <<'EOF'
set -eu

[ "$(id -u)" -eq 0 ] || { echo "patchy-hosts must run as root (via sudo)" >&2; exit 1; }

case "${1:-}" in
    check) echo "$PATCHY_HELPER_VERSION"; exit 0 ;;
    sync) shift ;;
    *) echo "usage: patchy-hosts sync [domain ...]" >&2; exit 64 ;;
esac

for domain in "$@"; do
    case "$domain" in
        ''|*[!a-zA-Z0-9.-]*|-*|.*|*-|*.|*..*)
            echo "patchy-hosts: invalid domain: $domain" >&2
            exit 64
            ;;
    esac
done

# Same filesystem as /etc/hosts so mv is atomic — a half-written hosts
# file would kill all name resolution.
tmp=$(mktemp /etc/hosts.patchy.XXXXXX)
trap 'rm -f "$tmp"' EXIT
grep -v '# patchy$' /etc/hosts > "$tmp" || true
for domain in "$@"; do
    printf '127.0.0.1 %s # patchy\n' "$domain" >> "$tmp"
    printf '::1 %s # patchy\n' "$domain" >> "$tmp"
done
chmod 644 "$tmp"
chown root:wheel "$tmp"
mv "$tmp" /etc/hosts
trap - EXIT
EOF
}

# The sudoers rule installed by trust_patchy grants passwordless root to
# whoever can produce the file at $HELPER_PATH, so every directory in that
# path must be root-controlled — otherwise a non-root owner of an ancestor
# directory (e.g. a user/admin-writable /usr/local on Intel Homebrew) could
# swap in their own "helper" and the sudoers rule would run it as root.
function assert_root_owned_path() {
    local dir=$1 info uid perm group_bit other_bit
    info=$(stat -f '%u %Lp' "$dir" 2>/dev/null) || {
        echo "Error: cannot stat $dir; trust cannot be safely installed." >&2
        return 1
    }
    uid=${info%% *}
    perm=${info##* }
    group_bit=${perm[-2]}
    other_bit=${perm[-1]}
    if [ "$uid" -ne 0 ] || (( (group_bit & 2) || (other_bit & 2) )); then
        echo "Error: $dir is owned by uid $uid with mode $perm — writable by" >&2
        echo "non-root, so trust cannot be safely installed. The sudoers rule" >&2
        echo "trusts the path $HELPER_PATH, and anyone able to write to $dir" >&2
        echo "could substitute their own helper and gain passwordless root." >&2
        echo "Normal sudo-prompt mode (without 'trust') still works fine." >&2
        return 1
    fi
}

function trust_patchy() {
    if [ ! -t 0 ]; then
        echo "Run '$SCRIPT_NAME trust' in an interactive terminal (needs sudo)." >&2
        return 1
    fi

    local ancestor
    for ancestor in /usr /usr/local "${HELPER_PATH:h}"; do
        [ -d "$ancestor" ] || continue
        assert_root_owned_path "$ancestor" || return 1
    done

    echo "Installing the patchy-hosts helper and sudoers rule (requires sudo)."
    echo "Afterwards patchy can update /etc/hosts without a password prompt."

    local user tmp_helper tmp_sudoers
    user=$(whoami)
    tmp_helper=$(mktemp) || return 1
    write_hosts_helper > "$tmp_helper" || { rm -f "$tmp_helper"; return 1; }
    if [ ! -s "$tmp_helper" ]; then
        echo "Error: generated helper script is empty; nothing installed." >&2
        rm -f "$tmp_helper"
        return 1
    fi
    tmp_sudoers=$(mktemp) || { rm -f "$tmp_helper"; return 1; }
    printf '%s ALL=(root) NOPASSWD: %s\n' "$user" "$HELPER_PATH" > "$tmp_sudoers"

    # A malformed sudoers.d file can break sudo entirely — validate before
    # anything is installed.
    if ! visudo -cf "$tmp_sudoers" >/dev/null; then
        echo "Error: generated sudoers rule failed validation; nothing installed." >&2
        rm -f "$tmp_helper" "$tmp_sudoers"
        return 1
    fi

    sudo /usr/bin/install -d -m 755 -o root -g wheel "${HELPER_PATH:h}" &&
        sudo /usr/bin/install -m 755 -o root -g wheel "$tmp_helper" "$HELPER_PATH" &&
        sudo /usr/bin/install -m 440 -o root -g wheel "$tmp_sudoers" "$SUDOERS_FILE"
    local rc=$?
    rm -f "$tmp_helper" "$tmp_sudoers"
    if [ "$rc" -ne 0 ]; then
        echo "Trust setup failed — run '$SCRIPT_NAME untrust' to remove any partial install." >&2
        return 1
    fi
    echo "Done. start/stop/add/rm will no longer prompt for a password."
}

function untrust_patchy() {
    if [ ! -f "$SUDOERS_FILE" ] && [ ! -f "$HELPER_PATH" ]; then
        echo "Trust is not installed."
        return 0
    fi
    echo "Removing the sudoers rule and helper (requires sudo)..."
    sudo rm -f "$SUDOERS_FILE" "$HELPER_PATH"
    echo "Done. /etc/hosts updates will prompt for your password again."
}

# Offer a www alias on apex adds. Default Yes; non-interactive stdin takes
# the default so scripted adds don't hang. Prompt goes to stderr because
# callers capture stdout. The answer is recorded as a ServerAlias — hosts
# entries, certs, and teardown all derive from that.
function prompt_www_alias() {
    local domain=$1 alias reply
    alias=$(www_alias_for "$domain")
    [ -n "$alias" ] || return 0
    if [ -t 0 ]; then
        printf "Also serve %s? [Y/n] " "$alias" >&2
        read -r reply
        case "$reply" in
            [nN]|[nN][oO]) return 0 ;;
        esac
    fi
    echo "$alias"
}

# Routing a real domain hides its live site on this Mac — make sure that's
# intended. .test is fake by definition and .local never leaves the LAN.
function confirm_real_domain() {
    local domain=$1 www=${2:-}
    case "${domain##*.}" in
        test|local) return 0 ;;
    esac
    local names="$domain"
    [ -n "$www" ] && names="$domain (and $www)"
    echo "Routing $names to this Mac. If $domain is a real website, it will be"
    echo "unreachable here until you run '$SCRIPT_NAME rm $domain' or '$SCRIPT_NAME stop'."
    printf "Continue? [y/N] "
    local reply
    read -r reply
    case "$reply" in
        y|Y|yes|YES) ;;
        *) echo "Aborted."; return 1 ;;
    esac
}

# Migrate hostess-era /etc/hosts entries. hostess consolidates every name
# onto one "127.0.0.1 localhost a b c…" line, so domains are matched as
# whitespace-delimited tokens and removed token-wise — never line-wise.
function migrate_hosts_entries() {
    local domain escaped stale=()
    local unmarked
    unmarked=$(grep -E '^[[:space:]]*127\.0\.0\.1[[:space:]]' /etc/hosts | grep -v '# patchy$')
    for domain in $(list_domains); do
        [ "$domain" = "localhost" ] && continue
        escaped="${domain//./\\.}"
        if echo "$unmarked" | grep -qE "[[:space:]]$escaped([[:space:]]|\$)"; then
            stale+=("$domain")
        fi
    done
    [ ${#stale[@]} -eq 0 ] && return 0
    echo "Migrating stale /etc/hosts entries..."
    local args=()
    for domain in "${stale[@]}"; do
        escaped="${domain//./\\.}"
        args+=(-e "/^[[:space:]]*127\.0\.0\.1[[:space:]]/{" \
               -e "/# patchy\$/!s/[[:space:]]+($escaped)([[:space:]]|\$)/\\2/g" \
               -e "}")
    done
    sudo sed -i '' -E "${args[@]}" /etc/hosts || return 1
}

# Tear down the pre-v0.9 dnsmasq DNS layer. Patchy-owned resolver files are
# identified by our port — other tools' files are never touched. dnsmasq
# itself stays installed; uninstalling software is the user's call.
function migrate_dnsmasq() {
    local f found=0
    for f in "$RESOLVER_DIR"/*(N); do
        grep -qE "^port[[:space:]]+$DNSMASQ_PORT\$" "$f" 2>/dev/null || continue
        found=1
        echo "Removing legacy resolver file $f (requires sudo)..."
        sudo rm -f "$f" || echo "Warning: could not remove $f — re-run '$SCRIPT_NAME setup' to retry." >&2
    done
    if [ -f "$PATCHY_DNS_CONF" ]; then
        found=1
        rm -f "$PATCHY_DNS_CONF"
        echo "Removed $PATCHY_DNS_CONF"
    fi
    [ "$found" -eq 1 ] || return 0
    if [ -d "$BREW_PREFIX/opt/dnsmasq" ]; then
        echo "Stopping dnsmasq (no longer used by patchy)..."
        brew services stop dnsmasq
        echo "To remove it entirely: brew uninstall dnsmasq"
    fi
    # Answers cached from the dnsmasq era keep their TTLs; flush once so
    # sites cut over to /etc/hosts immediately.
    flush_dns_cache
}

function setup_hosts() {
    if [ ! -t 0 ]; then
        echo "Skipping /etc/hosts configuration (no interactive terminal for sudo)."
        echo "Run '$SCRIPT_NAME setup' in a terminal to finish."
        return 0
    fi
    echo "Configuring /etc/hosts routing (requires sudo)..."
    echo "Backup: /etc/hosts.patchy-bkp"
    sudo cp /etc/hosts /etc/hosts.patchy-bkp || return 1
    migrate_dnsmasq
    migrate_hosts_entries || return 1
    hosts_sync $(list_hosts_names) || return 1
}

function open_in_editor() {
    local file=$1
    # Honor $VISUAL, then $EDITOR, falling back to `nano` (preinstalled on macOS).
    local editor="${VISUAL:-${EDITOR:-nano}}"
    if ! command -v "${editor%% *}" >/dev/null 2>&1; then
        echo "Editor '$editor' not found. Set \$VISUAL or \$EDITOR to your preferred editor." >&2
        return 1
    fi
    $editor "$file"
}

function config_apache() {
    echo "Editing configuration for Apache server..."
    echo "$APACHE_CONFIG"
    open_in_editor "$APACHE_CONFIG"
}

function config_php() {
    echo "Editing configuration for PHP..."
    local ini_file
    ini_file=$(php --ini | grep "Loaded Configuration File" | awk '{print $4}' | sed 's/"//g')
    echo "$ini_file"
    open_in_editor "$ini_file"
}

function tail_logs() {
    echo "Tailing logs for Apache server... $LOG_DIR"
    tail -f "$LOG_DIR"/*
}

function errors() {
    local arg=$1
    local log="$LOG_DIR/error_log"
    echo "Error log... $log"
    if [ "$arg" = "-f" ]; then
        tail -f "$log"
    else
        tail -n "$arg" "$log"
    fi
}

# The quick tunnel's public link, as cloudflared logs it. Its log also
# mentions the API host, which is not the link.
function share_url_in() {
    grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$1" | grep -v '^https://api\.' | head -n 1
}

# Starts a share's cloudflared in the background and waits until interrupted.
# A stable share knows its address up front and is ready once cloudflared
# registers a connection; a quick tunnel's address is read from its log.
# Returns 0 when stopped by a signal, 1 if the tunnel quit after it was ready,
# 2 if it quit (or was given up on) before; SHARE_LOG then holds its log.
function run_share_tunnel() {
    local domain=$1 address=$2 notice=$3
    shift 3
    SHARE_LOG=""
    local log
    log=$(mktemp -t patchy-share) || return 2

    echo "Requesting a public link for $domain..."

    # A GUI may signal only this process, so cloudflared is stopped explicitly.
    # The trap is set before launch so an early signal can't orphan it.
    local pid="" stopping=0
    trap 'stopping=1; [ -n "$pid" ] && kill -TERM $pid 2>/dev/null' INT TERM HUP

    "$@" >"$log" 2>&1 &
    pid=$!
    [ "$stopping" -eq 1 ] && kill -TERM "$pid" 2>/dev/null

    local url=""
    while [ -z "$url" ] && [ "$stopping" -eq 0 ] && kill -0 "$pid" 2>/dev/null; do
        if [ -n "$address" ]; then
            if grep -q 'Registered tunnel connection' "$log"; then
                url=$address
            elif grep -q 'Tunnel not found' "$log"; then
                # A deleted tunnel never exits on its own; cloudflared just retries.
                kill -TERM "$pid" 2>/dev/null
                break
            fi
        else
            url=$(share_url_in "$log")
        fi
        [ -z "$url" ] && sleep 0.2
    done

    if [ -n "$url" ] && [ "$stopping" -eq 0 ]; then
        echo "Sharing $domain at $url"
        echo "$notice"
    fi

    # A trapped signal ends wait early, so keep waiting until cloudflared is gone.
    while kill -0 "$pid" 2>/dev/null; do
        wait "$pid" 2>/dev/null
    done
    trap - INT TERM HUP

    local result=0
    if [ "$stopping" -eq 1 ]; then
        echo "Stopped sharing $domain."
    elif [ -z "$url" ]; then
        result=2
    else
        echo "The link stopped working because cloudflared quit:"
        tail -n 10 "$log"
        result=1
    fi
    SHARE_LOG=$(<"$log")
    rm -f "$log"
    return $result
}

# Serve one site at a temporary trycloudflare.com link. cloudflared sends the
# site's name so Apache picks its vhost, and checks the site's mkcert cert
# against mkcert's root CA.
function share_quick() {
    local domain=$1
    run_share_tunnel "$domain" "" "Anyone with this link can see the site. Press Ctrl-C to stop sharing." \
        cloudflared tunnel --no-autoupdate \
            --url https://localhost:443 \
            --http-host-header "$domain" \
            --origin-server-name "$domain" \
            --origin-ca-pool "$(mkcert -CAROOT)/rootCA.pem"
    local result=$?
    if [ "$result" -eq 2 ]; then
        echo "cloudflared stopped before the link was ready:"
        tail -n 10 <<<"$SHARE_LOG"
        return 1
    fi
    return $result
}

# The checks every share needs, then a stable or quick share.
function share_site() {
    local domain=$1
    shift
    local quick=0 name="" protect="" new_password=0
    while [ $# -gt 0 ]; do
        case $1 in
            --quick) quick=1 ;;
            --name)
                name=${2:-}
                if [ -z "$name" ]; then
                    echo "Please provide a name after --name."
                    return 1
                fi
                shift
                ;;
            --open) protect=open ;;
            --password) protect=password ;;
            --new-password) new_password=1 ;;
            *)
                echo "Unknown option: $1"
                return 1
                ;;
        esac
        shift
    done
    if [ "$quick" -eq 1 ] && { [ -n "$name" ] || [ -n "$protect" ] || [ "$new_password" -eq 1 ]; }; then
        echo "--quick can't be combined with other options."
        return 1
    fi

    if ! site_exists "$domain"; then
        echo "Site does not exist... $domain"
        return 1
    fi
    if ! is_apache_running; then
        echo "Apache isn't running. Start it with: $SCRIPT_NAME start"
        return 1
    fi
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo "cloudflared is required: brew install cloudflared"
        return 1
    fi

    if [ "$quick" -eq 1 ] || ! share_ready; then
        if [ -n "$name" ] || [ -n "$protect" ] || [ "$new_password" -eq 1 ]; then
            echo "Set up your own domain first: $SCRIPT_NAME share setup <domain>"
            return 1
        fi
        share_quick "$domain"
        return
    fi

    share_prepare "$domain" "$name" || return 1
    local dir="$SHARE_DIR/sites/$domain" changed=0
    case $protect in
        open) [ -f "$dir/open" ] || { touch "$dir/open"; changed=1; } ;;
        password) [ -f "$dir/open" ] && { rm -f "$dir/open"; changed=1; } ;;
    esac
    if [ "$new_password" -eq 1 ]; then
        set_share_password "$domain" "$(make_share_password)"
        changed=1
    fi
    if [ "$changed" -eq 1 ]; then
        apply_share_vhost "$domain" || return 1
    fi
    share_stable "$domain"
}

function share_domain() {
    cat "$SHARE_DIR/domain" 2>/dev/null
}

# True once 'patchy share setup' has connected a domain.
function share_ready() {
    [ -s "$SHARE_DIR/cert.pem" ] && [ -s "$SHARE_DIR/domain" ]
}

# cloudflared's tunnel commands, using Patchy's login rather than ~/.cloudflared.
function cf_tunnel() {
    cloudflared tunnel --origincert "$SHARE_DIR/cert.pem" "$@"
}

# The domain a Cloudflare login approved. The login cert holds a token with
# the zone's ID and an API token that can read the zone's name.
function cert_zone_name() {
    local token zone_id api_token
    token=$(sed -n '/BEGIN ARGO TUNNEL TOKEN/,/END ARGO TUNNEL TOKEN/{/-----/d;p;}' "$1" | tr -d '\n' | base64 --decode 2>/dev/null) || return 1
    zone_id=$(jq -r '.zoneID // empty' <<<"$token" 2>/dev/null)
    api_token=$(jq -r '.apiToken // empty' <<<"$token" 2>/dev/null)
    [ -n "$zone_id" ] && [ -n "$api_token" ] || return 1
    curl -fsS -H "Authorization: Bearer $api_token" \
        "https://api.cloudflare.com/client/v4/zones/$zone_id" 2>/dev/null | jq -r '.result.name // empty'
}

# Connect a Cloudflare domain for stable share addresses. cloudflared's login
# always writes ~/.cloudflared/cert.pem, so any existing one is set aside and
# put back, and the new one moves to Patchy's folder.
function share_setup() {
    local domain=${1:-}
    if [ -z "$domain" ]; then
        echo "Please provide your domain, e.g. $SCRIPT_NAME share setup example.com"
        return 1
    fi
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo "cloudflared is required: brew install cloudflared"
        return 1
    fi

    local cf_dir="$HOME/.cloudflared" saved=""
    mkdir -p "$cf_dir"
    if [ -f "$cf_dir/cert.pem" ]; then
        saved=$(mktemp -t patchy-cert) && mv "$cf_dir/cert.pem" "$saved"
    fi

    echo "Opening Cloudflare in your browser. Choose $domain and click Authorize..."
    local interrupted=0 approved=""
    trap 'interrupted=1' INT TERM HUP
    if cloudflared tunnel login && [ "$interrupted" -eq 0 ] && [ -f "$cf_dir/cert.pem" ]; then
        approved=$(cert_zone_name "$cf_dir/cert.pem")
    fi
    trap - INT TERM HUP

    local result=1
    if [ "$interrupted" -eq 1 ] || [ ! -f "$cf_dir/cert.pem" ]; then
        echo "No domain was connected. $SCRIPT_NAME share will keep giving temporary links."
    elif [ "$approved" != "$domain" ]; then
        if [ -n "$approved" ]; then
            echo "You approved $approved in the browser, not $domain. Run '$SCRIPT_NAME share setup $domain' again and choose $domain."
        else
            echo "Couldn't check which domain Cloudflare approved, so nothing was changed."
        fi
    else
        if share_ready && [ "$(share_domain)" != "$domain" ]; then
            echo "Switching from $(share_domain) to $domain..."
            share_forget_all
        fi
        mkdir -p "$SHARE_DIR" && chmod 700 "$SHARE_DIR"
        mv "$cf_dir/cert.pem" "$SHARE_DIR/cert.pem" && chmod 600 "$SHARE_DIR/cert.pem"
        echo "$domain" > "$SHARE_DIR/domain"
        echo "Connected. $SCRIPT_NAME share will now give each site an address on $domain."
        result=0
    fi
    rm -f "$cf_dir/cert.pem"
    [ -n "$saved" ] && mv "$saved" "$cf_dir/cert.pem"
    return $result
}

# Forget every site's stable address (tunnels deleted, DNS records reported).
function share_forget_all() {
    local dir
    for dir in "$SHARE_DIR"/sites/*(N/); do
        share_forget_site "${dir:t}"
    done
    rm -rf "$SHARE_DIR/vhosts"
}

function share_reset() {
    if ! share_ready; then
        echo "No sharing domain is set up. $SCRIPT_NAME share gives temporary links."
        return 0
    fi
    local domain
    domain=$(share_domain)
    share_forget_all
    rm -rf "$SHARE_DIR"
    is_apache_running && apachectl -k graceful >/dev/null 2>&1
    echo "Disconnected $domain. $SCRIPT_NAME share will give temporary links again."
}

# Remove a site's stable address from this Mac and its tunnel from Cloudflare.
# cloudflared can't delete DNS records, so the leftover one is reported.
function share_forget_site() {
    local domain=$1 dir="$SHARE_DIR/sites/$1" host tunnel
    [ -f "$dir/name" ] || return 0
    host="$(<"$dir/name").$(share_domain)"
    tunnel=$(<"$dir/tunnel")
    if ! cf_tunnel delete -f "$tunnel" >/dev/null 2>&1; then
        echo "Couldn't delete the tunnel $tunnel on Cloudflare. Delete it in the Cloudflare dashboard (Networks › Tunnels)."
    fi
    rm -rf "$dir" "$SHARE_DIR/vhosts/$domain.conf"
    echo "$host still has a DNS record on Cloudflare. Delete it in the Cloudflare dashboard (DNS) if you don't need it."
}

# harbor.test → harbor, shop.northwind.test → shop-northwind
function share_default_name() {
    local base=${1%.*}
    echo "${base//./-}"
}

# One DNS label: Cloudflare's free certificates cover one level under the domain.
function valid_share_name() {
    local label='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
    [[ $1 =~ $label ]]
}

# 12 characters in groups of 4, without look-alikes (0/O, 1/l/I), to read out to a client.
function make_share_password() {
    local chars="abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789" pw="" i n
    for i in {1..12}; do
        n=$(od -An -N2 -tu2 /dev/urandom | tr -d ' ')
        pw+=${chars[$(( n % ${#chars} + 1 ))]}
        (( i % 4 == 0 && i < 12 )) && pw+="-"
    done
    echo "$pw"
}

function set_share_password() {
    local dir="$SHARE_DIR/sites/$1" pw=$2
    ( umask 077; echo "$pw" > "$dir/password" )
    htpasswd -cbB "$dir/htpasswd" "$SHARE_USER" "$pw" >/dev/null 2>&1
}

# Points a stable address at a tunnel. Never replaces an existing record.
function share_route() {
    local tunnel=$1 host=$2 log=$3
    cf_tunnel route dns "$tunnel" "$host" >"$log" 2>&1 && return 0
    if grep -qi 'already exists' "$log"; then
        echo "$host is already used on $(share_domain). Choose another name with --name."
    else
        echo "Couldn't create $host on Cloudflare:"
        tail -n 5 "$log"
    fi
    return 1
}

function write_tunnel_config() {
    local domain=$1 dir="$SHARE_DIR/sites/$1"
    cat > "$dir/tunnel.yml" <<EOF
# Managed by Patchy.
tunnel: $(jq -r '.TunnelID' "$dir/tunnel.json")
credentials-file: "$dir/tunnel.json"
ingress:
  - hostname: $(<"$dir/name").$(share_domain)
    service: https://localhost:443
    originRequest:
      originServerName: $domain
      caPool: "$(mkcert -CAROOT)/rootCA.pem"
  - service: http_status:404
EOF
}

# The vhost that answers to a site's stable address: the site's own folder,
# logs and certificate, plus a password unless the site is shared open.
function write_share_vhost() {
    local domain=$1 dir="$SHARE_DIR/sites/$1" docroot auth=""
    docroot=$(sed -n 's/^[[:space:]]*DocumentRoot[[:space:]]*"\(.*\)".*/\1/p' "$VHOSTS_DIR/$domain.conf" | head -n1)
    if [ ! -f "$dir/open" ]; then
        auth="
    <Location />
        AuthType Basic
        AuthName \"Preview\"
        AuthUserFile \"$dir/htpasswd\"
        Require valid-user
    </Location>"
    fi
    mkdir -p "$SHARE_DIR/vhosts"
    cat > "$SHARE_DIR/vhosts/$domain.conf" <<EOF
# Managed by Patchy — $domain's stable share address.
<VirtualHost *:443>
    DocumentRoot "$docroot"
    ServerName $(<"$dir/name").$(share_domain)
    ErrorLog "$LOG_DIR/$domain-error_log"
    CustomLog "$LOG_DIR/$domain-access_log" common
    SSLEngine on
    SSLCertificateFile "$CERT_DIR/$domain.pem"
    SSLCertificateKeyFile "$CERT_DIR/$domain-key.pem"$auth
</VirtualHost>
EOF
}

function ensure_shares_included() {
    local include_line="IncludeOptional $SHARE_DIR/vhosts/*.conf"
    [ -n "$(active_line_no "$include_line" "$APACHE_CONFIG")" ] && return 0
    backup_config
    echo "$include_line" >> "$APACHE_CONFIG"
}

# Writes the share vhost and reloads Apache without dropping connections.
# If Apache rejects it, the vhost is removed and nothing is reloaded.
function apply_share_vhost() {
    local domain=$1
    write_share_vhost "$domain"
    ensure_shares_included
    if ! apachectl -t >/dev/null 2>&1; then
        echo "Apache rejected the sharing setup for $domain, so it was removed:"
        apachectl -t 2>&1 | tail -n 5
        rm -f "$SHARE_DIR/vhosts/$domain.conf"
        return 1
    fi
    is_apache_running && apachectl -k graceful >/dev/null 2>&1
    return 0
}

# Give a site its stable address the first time it is shared: a tunnel of its
# own, a DNS record, a password and a share vhost. Undone if any step fails.
function share_prepare() {
    local domain=$1 want=$2 dir="$SHARE_DIR/sites/$1"
    if [ -f "$dir/name" ]; then
        if [ -z "$want" ] || [ "$want" = "$(<"$dir/name")" ]; then
            [ -f "$SHARE_DIR/vhosts/$domain.conf" ] || apply_share_vhost "$domain"
            return
        fi
        share_rename "$domain" "$want"
        return
    fi

    local name=${want:-$(share_default_name "$domain")}
    if ! valid_share_name "$name"; then
        echo "\"$name\" can't be used in a web address. Use lowercase letters, numbers and hyphens."
        return 1
    fi
    local host tunnel="patchy-$name" tmp
    host="$name.$(share_domain)"
    echo "Setting up $host (first share only)..."
    tmp=$(mktemp -d -t patchy-share-site) || return 1
    if ! cf_tunnel create --credentials-file "$tmp/tunnel.json" "$tunnel" >"$tmp/log" 2>&1; then
        if grep -qi 'already exists' "$tmp/log"; then
            echo "The tunnel $tunnel is already used. Choose another name with --name."
        else
            echo "Couldn't create a tunnel on Cloudflare:"
            tail -n 5 "$tmp/log"
        fi
        rm -rf "$tmp"
        return 1
    fi
    if ! share_route "$tunnel" "$host" "$tmp/log"; then
        cf_tunnel delete -f "$tunnel" >/dev/null 2>&1
        rm -rf "$tmp"
        return 1
    fi

    mkdir -p "$dir" && chmod 700 "$SHARE_DIR" "$dir"
    mv "$tmp/tunnel.json" "$dir/tunnel.json" && chmod 600 "$dir/tunnel.json"
    rm -rf "$tmp"
    echo "$name" > "$dir/name"
    echo "$tunnel" > "$dir/tunnel"
    set_share_password "$domain" "$(make_share_password)"
    write_tunnel_config "$domain"
    if ! apply_share_vhost "$domain"; then
        share_forget_site "$domain"
        return 1
    fi
}


# Run a site's own tunnel until interrupted. A tunnel deleted in the
# dashboard is recreated once, for the site's own recorded address.
function share_stable() {
    local domain=$1 dir="$SHARE_DIR/sites/$1" address notice
    address="https://$(<"$dir/name").$(share_domain)"
    if [ -f "$dir/open" ]; then
        notice="Anyone with the address can see the site. Press Ctrl-C to stop sharing."
    else
        notice="Username: $SHARE_USER   Password: $(<"$dir/password")"$'\n'"Anyone with the address and password can see the site. Press Ctrl-C to stop sharing."
    fi
    local attempt result
    for attempt in 1 2; do
        run_share_tunnel "$domain" "$address" "$notice" \
            cloudflared tunnel --no-autoupdate --origincert "$SHARE_DIR/cert.pem" --config "$dir/tunnel.yml" run
        result=$?
        [ "$result" -ne 2 ] && return $result
        if [ "$attempt" -eq 1 ] && grep -q 'Tunnel not found' <<<"$SHARE_LOG"; then
            echo "The tunnel for $domain was deleted on Cloudflare. Creating it again..."
            share_recreate "$domain" || return 1
            continue
        fi
        break
    done
    if grep -qiE 'origin cert|unauthori[sz]ed|authentication' <<<"$SHARE_LOG"; then
        echo "Your Cloudflare login has expired. Run '$SCRIPT_NAME share setup $(share_domain)' again."
    else
        echo "cloudflared stopped before the link was ready:"
        tail -n 10 <<<"$SHARE_LOG"
    fi
    return 1
}

# Move a site to a new stable name on the same tunnel. The old record stays.
function share_rename() {
    local domain=$1 want=$2 dir="$SHARE_DIR/sites/$1" old host log
    if ! valid_share_name "$want"; then
        echo "\"$want\" can't be used in a web address. Use lowercase letters, numbers and hyphens."
        return 1
    fi
    old="$(<"$dir/name").$(share_domain)"
    host="$want.$(share_domain)"
    log=$(mktemp -t patchy-share-route) || return 1
    if ! share_route "$(<"$dir/tunnel")" "$host" "$log"; then
        rm -f "$log"
        return 1
    fi
    rm -f "$log"
    echo "$want" > "$dir/name"
    write_tunnel_config "$domain"
    apply_share_vhost "$domain" || return 1
    echo "$old still has a DNS record on Cloudflare. Delete it in the Cloudflare dashboard (DNS) if you don't need it."
}

# Recreate a site's tunnel after it was deleted in the dashboard, and point
# the site's own recorded address at it (the only overwrite Patchy makes).
function share_recreate() {
    local domain=$1 dir="$SHARE_DIR/sites/$1" tunnel host log
    tunnel=$(<"$dir/tunnel")
    host="$(<"$dir/name").$(share_domain)"
    log=$(mktemp -t patchy-share-route) || return 1
    cf_tunnel delete -f "$tunnel" >/dev/null 2>&1
    rm -f "$dir/tunnel.json"
    if ! cf_tunnel create --credentials-file "$dir/tunnel.json" "$tunnel" >"$log" 2>&1 \
        || ! cf_tunnel route dns --overwrite-dns "$tunnel" "$host" >>"$log" 2>&1; then
        echo "Couldn't create the tunnel again:"
        tail -n 5 "$log"
        rm -f "$log"
        return 1
    fi
    rm -f "$log"
    chmod 600 "$dir/tunnel.json"
    write_tunnel_config "$domain"
}

# Line number of the first ACTIVE (uncommented) line containing the needle
function active_line_no() {
    local needle=$1 file=$2
    grep -nF -- "$needle" "$file" 2>/dev/null | grep -vE '^[0-9]+:[[:space:]]*#' | head -n1 | cut -d: -f1
}

# Ensure httpd.conf wildcard-includes the per-site config directory.
# Strips any legacy per-site Include lines on first run.
function ensure_sites_included() {
    local include_line="IncludeOptional $VHOSTS_DIR/*.conf"
    local has_wildcard=0
    local has_legacy=0

    [ -n "$(active_line_no "$include_line" "$APACHE_CONFIG")" ] && has_wildcard=1
    grep -qF -- "Include $VHOSTS_DIR/" "$APACHE_CONFIG" && has_legacy=1

    if [ "$has_wildcard" -eq 1 ] && [ "$has_legacy" -eq 0 ]; then
        return 0
    fi

    backup_config

    if [ "$has_legacy" -eq 1 ]; then
        local tmp="$APACHE_CONFIG.tmp"
        grep -vF -- "Include $VHOSTS_DIR/" "$APACHE_CONFIG" > "$tmp"
        if [ -s "$tmp" ]; then
            mv "$tmp" "$APACHE_CONFIG"
        else
            rm -f "$tmp"
        fi
    fi

    if [ "$has_wildcard" -eq 0 ]; then
        echo "$include_line" >> "$APACHE_CONFIG"
        echo "Configured Apache to include sites from $VHOSTS_DIR"
    fi
}

# patchy.conf owns Listen — comment out httpd.conf's own Listen lines
# (duplicate Listen directives for the same port are a fatal startup error)
function disable_main_conf_listen() {
    if grep -q '^Listen ' "$APACHE_CONFIG"; then
        sed -i '' 's/^Listen /#Listen /' "$APACHE_CONFIG"
        echo "Commented out Listen lines in httpd.conf (now set in patchy.conf)"
    fi
}

# patchy.conf owns mod_php — comment out httpd.conf's LoadModule php lines,
# including duplicates accumulated by older 'patchy php' runs
function disable_main_conf_php() {
    if grep -q '^LoadModule php' "$APACHE_CONFIG"; then
        sed -i '' 's/^LoadModule php/#LoadModule php/' "$APACHE_CONFIG"
        echo "Commented out LoadModule php lines in httpd.conf (now set in patchy.conf)"
    fi
}

# Ensure httpd.conf includes patchy.conf BEFORE the per-site vhosts: Apache
# parses sequentially, and vhost directives like RewriteEngine error at parse
# time if their module loads later.
function ensure_patchy_included() {
    local include_line="Include $PATCHY_CONF"
    local sites_line="IncludeOptional $VHOSTS_DIR/*.conf"
    local inc_no sites_no
    inc_no=$(active_line_no "$include_line" "$APACHE_CONFIG")
    sites_no=$(active_line_no "$sites_line" "$APACHE_CONFIG")

    if [ -n "$inc_no" ] && { [ -z "$sites_no" ] || [ "$inc_no" -lt "$sites_no" ]; }; then
        return 0
    fi

    local tmp="$APACHE_CONFIG.tmp"
    if [ -n "$sites_no" ]; then
        grep -vF -- "$include_line" "$APACHE_CONFIG" | \
            awk -v inc="$include_line" -v sites="$sites_line" '
                { line = $0; sub(/^[[:space:]]+/, "", line) }
                index(line, sites) == 1 && !done { print inc; done = 1 }
                { print }
            ' > "$tmp"
    else
        grep -vF -- "$include_line" "$APACHE_CONFIG" > "$tmp"
        echo "$include_line" >> "$tmp"
    fi
    if [ -s "$tmp" ] && grep -qF -- "$include_line" "$tmp"; then
        mv "$tmp" "$APACHE_CONFIG"
        echo "Configured httpd.conf to include $PATCHY_CONF"
    else
        rm -f "$tmp"
        echo "Error: failed to update $APACHE_CONFIG; no changes made." >&2
        return 1
    fi
}

function add_site() {
    local domain=$1
    local docroot=${2:-}
    [ -z "$docroot" ] && docroot="$DEFAULT_WEBROOT/$domain"

    if site_exists "$domain"; then
        echo "Site already exists... $domain"
        return 1
    fi

    if [ ! -d "$docroot" ]; then
        echo "Creating document root at $docroot"
        mkdir -p "$docroot"
    fi

    docroot=$(cd "$docroot" && pwd)

    echo "Adding a new site... $domain"

    local www_alias
    www_alias=$(prompt_www_alias "$domain")

    confirm_real_domain "$domain" "$www_alias" || return 1
    # Hosts entry first: a declined sudo aborts before anything is created.
    hosts_sudo_note
    hosts_add "$domain" ${www_alias:+"$www_alias"} || return 1

    echo "Creating SSL certificates..."
    make_cert "$domain" ${www_alias:+"$www_alias"}

    mkdir -p "$VHOSTS_DIR"
    ensure_sites_included

    echo "Creating Apache config file..."
    local conf_file="$VHOSTS_DIR/$domain.conf"
    local alias_line=""
    [ -n "$www_alias" ] && alias_line=$'\n'"    ServerAlias $www_alias"
    cat > "$conf_file" <<EOF
<Directory "$docroot">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

<VirtualHost *:80>
    DocumentRoot "$docroot"
    ServerName $domain$alias_line
    ErrorLog "$LOG_DIR/$domain-error_log"
    CustomLog "$LOG_DIR/$domain-access_log" common
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^/?(.*) https://%{HTTP_HOST}/\$1 [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    DocumentRoot "$docroot"
    ServerName $domain$alias_line
    ErrorLog "$LOG_DIR/$domain-error_log"
    CustomLog "$LOG_DIR/$domain-access_log" common
    SSLEngine on
    SSLCertificateFile "$CERT_DIR/$domain.pem"
    SSLCertificateKeyFile "$CERT_DIR/$domain-key.pem"
</VirtualHost>
EOF

    if ! verify_config; then
        echo "Rolling back site creation..."
        remove_domain "$domain"
        remove_cert "$domain"
        return 1
    fi

    restart_server
}

function root_cert_exists() {
    local rootdir
    rootdir=$(mkcert -CAROOT)
    [ -f "$rootdir/rootCA.pem" ] && [ -f "$rootdir/rootCA-key.pem" ]
}

# Extra args become SAN names. Filenames are pinned because mkcert's
# defaults change when a cert has multiple names, and the vhost SSL paths
# must never move.
function make_cert() {
    local domain=$1
    mkdir -p "$CERT_DIR"
    cd "$CERT_DIR" || return 1
    if ! root_cert_exists; then
        mkcert -install
    fi
    mkcert -cert-file "$domain.pem" -key-file "$domain-key.pem" "$@"
}

function remove_root_certs() {
    mkcert -uninstall
    local rootdir
    rootdir=$(mkcert -CAROOT)
    rm -f "$rootdir/rootCA.pem" "$rootdir/rootCA-key.pem"
}

function remove_cert() {
    local domain=$1
    cd "$CERT_DIR" 2>/dev/null || return 0
    rm -f "$domain.pem" "$domain-key.pem"
}

function refresh_certs() {
    cd "$CERT_DIR" || return 1
    remove_root_certs
    make_cert localhost
    local site
    for site in $(list_domains); do
        [ "$site" = "localhost" ] && continue
        rm -f "$site.pem" "$site-key.pem"
        make_cert "$site" $(list_site_aliases "$site")
    done
    # Apache keeps serving the old certs from memory until it reloads them
    if is_apache_running; then
        restart_server
    fi
}

function cert_days_left() {
    local cert=$1 end_date end_epoch secs
    end_date=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null) || return 1
    end_date=${end_date#notAfter=}
    # %e not %d: openssl space-pads single-digit days ("Sep  9").
    # LC_ALL=C: openssl always prints English month names, but %b parses
    # them in the user's locale, so a German/French/etc. Mac fails here.
    end_epoch=$(LC_ALL=C date -j -f "%b %e %T %Y %Z" "$end_date" +%s 2>/dev/null) || return 1
    secs=$(( end_epoch - $(date +%s) ))
    echo $(( secs < 0 ? (secs - 86399) / 86400 : secs / 86400 ))
}

function list_domains() {
    [ -d "$VHOSTS_DIR" ] || return 0
    local f
    for f in "$VHOSTS_DIR"/*.conf(N); do
        echo "${f:t:r}"
    done | sort
}

# Apex domains (exactly two labels, not already www.) get a www alias
# offer; subdomain sites never do. Echoes the alias or nothing.
function www_alias_for() {
    local domain=$1
    case "$domain" in
        www.*) ;;
        *.*.*) ;;
        *.*) echo "www.$domain" ;;
    esac
    return 0
}

# ServerAlias values recorded in a site's vhost conf — the durable record
# of the www answer given at add time. Handles multi-name alias lines.
function list_site_aliases() {
    awk '/^[[:space:]]*ServerAlias[[:space:]]/ { for (i = 2; i <= NF; i++) print $i }' \
        "$VHOSTS_DIR/$1.conf" 2>/dev/null | sort -u
    return 0
}

# Every name that must resolve locally: each site plus its aliases. Feeding
# the hosts sync from here means start/stop/rm need no www-specific code.
function list_hosts_names() {
    local domain
    for domain in $(list_domains); do
        echo "$domain"
        list_site_aliases "$domain"
    done | sort -u
    return 0
}

function list_sites() {
    if [ ! -d "$VHOSTS_DIR" ] || [ -z "$(list_domains)" ]; then
        echo "No sites configured."
        return 0
    fi
    local domain docroot https days needs_attention=0
    local orange="" red="" reset=""
    if [ -t 1 ]; then
        orange=$'\e[38;5;208m'
        red=$'\e[31m'
        reset=$'\e[0m'
    fi
    local dwidth=6
    while IFS= read -r domain; do
        (( ${#domain} > dwidth )) && dwidth=${#domain}
    done < <(list_domains)
    (( dwidth += 3 ))
    printf "%-${dwidth}s %-8s %s\n" "DOMAIN" "HTTPS" "DOCROOT"
    while IFS= read -r domain; do
        docroot=$(sed -n 's/^[[:space:]]*DocumentRoot[[:space:]]*"\(.*\)".*/\1/p' "$VHOSTS_DIR/$domain.conf" | head -n1)
        docroot="${docroot/#$HOME/~}"
        local color=""
        if [ ! -f "$CERT_DIR/$domain.pem" ]; then
            https="no"
        elif ! days=$(cert_days_left "$CERT_DIR/$domain.pem"); then
            https="invalid"
            color=$red
            needs_attention=1
        elif [ "$days" -lt 0 ]; then
            https="expired"
            color=$red
            needs_attention=1
        elif [ "$days" -le 30 ]; then
            https="${days}d"
            color=$orange
            needs_attention=1
        else
            https="${days}d"
        fi
        # color applied outside the padding so escape codes don't skew column width
        printf "%-${dwidth}s ${color}%-8s${reset} %s\n" "$domain" "$https" "$docroot"
    done < <(list_domains)
    if share_ready; then
        local share first=1
        for share in "$SHARE_DIR"/sites/*(N/); do
            if [ "$first" -eq 1 ]; then
                echo ""
                echo "Share addresses:"
                first=0
            fi
            printf "%-${dwidth}s https://%s.%s\n" "${share:t}" "$(<"$share/name")" "$(share_domain)"
        done
    fi
    if [ "$needs_attention" -eq 1 ]; then
        echo ""
        echo "Some certificates expire soon or are invalid. Run 'patchy refresh-certs' to regenerate them."
    fi
}

function site_exists() {
    local domain=$1
    [ -f "$VHOSTS_DIR/$domain.conf" ]
}

function remove_site() {
    local domain=$1

    if ! site_exists "$domain"; then
        echo "Site does not exist... $domain"
        return 1
    fi

    remove_domain "$domain" || return 1
    remove_cert "$domain"
    share_forget_site "$domain"
}

# Hosts teardown runs FIRST: a declined sudo leaves the site fully intact
# rather than half-removed. While stopped there are no patchy lines, so
# there is nothing to remove — and syncing then would wrongly resurrect
# the other sites' entries.
function remove_domain() {
    local domain=$1
    if hosts_active; then
        echo "Updating /etc/hosts..."
        hosts_remove "$domain" || return 1
    fi
    echo "Removing Apache config file..."
    rm -f "$VHOSTS_DIR/$domain.conf"
}

function verify_config() {
    if apachectl -t; then
        echo "Apache configuration is valid."
    else
        echo "Apache configuration is invalid."
        return 1
    fi
    if php --ini >/dev/null; then
        echo "PHP configuration is valid."
    else
        echo "PHP configuration is invalid."
        return 1
    fi
}

function backup_config() {
    # Remove backups older than 30 days
    find "$BREW_PREFIX/etc/httpd" -name "httpd.conf.bkp-*" -mtime +30 -exec rm {} \;
    # Create a fresh backup, remembering the path for restore-on-failure
    LAST_BACKUP="$APACHE_CONFIG.bkp-$(date +%Y%m%d%H%M%S)"
    cp "$APACHE_CONFIG" "$LAST_BACKUP"
}

function server_status() {
    if is_apache_running; then
        echo "Apache: Running"
    else
        echo "Apache: Stopped"
    fi
    local d domains=($(list_hosts_names)) missing=()
    for d in "${domains[@]}"; do
        hosts_entry_exists "$d" || missing+=("$d")
    done
    if [ ${#domains[@]} -eq 0 ]; then
        echo "Hosts:  No sites configured"
    elif [ ${#missing[@]} -eq 0 ]; then
        echo "Hosts:  Routing ${#domains[@]} name(s) to this Mac"
    elif [ ${#missing[@]} -eq ${#domains[@]} ]; then
        echo "Hosts:  Not routing (run '$SCRIPT_NAME start' to serve sites locally)"
    else
        echo "Hosts:  Routing $(( ${#domains[@]} - ${#missing[@]} )) of ${#domains[@]} name(s) — run '$SCRIPT_NAME start' to repair"
    fi
    if trust_active; then
        echo "Trust:  Passwordless /etc/hosts updates enabled"
    elif trust_installed; then
        echo "Trust:  Helper is out of date — run '$SCRIPT_NAME trust' to update it"
    fi
    if share_ready; then
        echo "Share:  Addresses on $(share_domain)"
    else
        echo "Share:  Temporary links (run '$SCRIPT_NAME share setup <domain>' to use your own)"
    fi
}

function server_info() {
    echo -e "\033[1mApache Server Info...\033[0m"
    apachectl -V | grep -E 'Server version|Server MPM|Server built'
}

function php_info() {
    echo -e "\033[1mPHP Version Info...\033[0m"
    php -v
}

# Resolve the Homebrew formula for a PHP version: "php" for the latest, "php@X.Y" otherwise
function php_formula_for_version() {
    local version=$1
    local php_formula="php@$version"
    local latest_version
    latest_version=$(brew info php --json=v2 2>/dev/null | jq -r '.formulae[0].versions.stable' | cut -d. -f1,2)
    if [ "$version" = "$latest_version" ]; then
        php_formula="php"
    fi
    echo "$php_formula"
}

# Build the Apache LoadModule line for a PHP version/formula
function php_module_line() {
    local version=$1
    local php_formula=$2
    local major_version="${version%%.*}"
    local module_path="$BREW_PREFIX/opt/$php_formula/lib/httpd/modules"
    if [ "$major_version" -ge 8 ]; then
        echo "LoadModule php_module $module_path/libphp.so"
    else
        echo "LoadModule php7_module $module_path/libphp7.so"
    fi
}

function switch_php_version() {
    if [ -z "${1:-}" ]; then
        echo "Please provide a PHP version (e.g., 7.4, 8.1, 8.2, 8.3, 8.4)"
        return 1
    fi

    local version=$1
    local php_formula
    php_formula=$(php_formula_for_version "$version")

    if ! brew list --formula 2>/dev/null | grep -E "^${php_formula}\$" >/dev/null; then
        echo "$php_formula is not installed."
        echo "Install it with: brew install $php_formula"
        return 1
    fi

    echo "Switching to PHP $version..."
    backup_config

    echo "Unlinking all PHP versions..."
    local formula
    for formula in $(brew list --formula | grep -E '^php(@[0-9.]+)?$'); do
        brew unlink "$formula" >/dev/null 2>&1 || true
    done

    echo "Linking PHP $version..."
    brew link --force --overwrite "$php_formula"

    echo "Updating Apache configuration..."

    local module_line
    module_line=$(php_module_line "$version" "$php_formula")
    if [ ! -f "${module_line##* }" ]; then
        echo "Warning: PHP module not found at ${module_line##* }"
    fi
    write_patchy_conf "$module_line"
    # Belt-and-suspenders for installs upgraded without re-running setup
    disable_main_conf_listen
    disable_main_conf_php
    ensure_sites_included
    ensure_patchy_included

    restart_server

    echo ""
    echo "PHP version switched to:"
    php -v | head -1
}

function install_pecl_extensions() {
    echo "Installing PECL extensions for current PHP version..."
    php -v | head -1
    echo ""

    echo "Installing required Homebrew dependencies..."
    brew install libyaml imagemagick libmemcached pkg-config zlib

    local pecl_ext_dir
    pecl_ext_dir=$(php -i | grep "^extension_dir" | head -1 | awk '{print $3}')
    echo "PECL extension directory: $pecl_ext_dir"

    if [ ! -d "$pecl_ext_dir" ]; then
        echo "Creating PECL directory: $pecl_ext_dir"
        mkdir -p "$pecl_ext_dir"
    fi

    local extensions=("redis" "apcu" "imagick" "yaml" "pcov" "memcached")
    local ext
    for ext in "${extensions[@]}"; do
        echo ""
        echo "Installing $ext..."
        case $ext in
            yaml)
                (echo "$(brew --prefix libyaml)"; yes "") | pecl install yaml || true
                ;;
            memcached)
                local zlib_dir
                zlib_dir=$(brew --prefix zlib)
                local libmemcached_dir
                libmemcached_dir=$(brew --prefix libmemcached)
                printf '%s\n' "$libmemcached_dir" "$zlib_dir" "no" "no" "no" "no" "no" "yes" "yes" | pecl install memcached || true
                ;;
            *)
                yes "" | pecl install "$ext" || true
                ;;
        esac
    done

    local ini_file
    ini_file=$(php -n -r "echo php_ini_loaded_file();" 2>/dev/null)
    if [ -z "$ini_file" ]; then
        ini_file="$BREW_PREFIX/etc/php/$(php -n -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')/php.ini"
    fi

    echo ""
    echo "Adding extensions to php.ini: $ini_file"

    for ext in "${extensions[@]}"; do
        if ! grep -qE "extension=.?${ext}(\.so)?.?$" "$ini_file"; then
            echo "extension=\"$ext.so\"" >> "$ini_file"
            echo "Added: extension=\"$ext.so\""
        else
            echo "Already configured: $ext"
        fi
    done

    echo ""
    echo "PECL extensions installed and configured."
}

# Rewrite the patchy-managed Apache include in full.
# <IfModule !…> guards avoid double-loading modules the user's httpd.conf
# already enables. Listen lives here exclusively: duplicate Listen directives
# are a fatal startup error, so httpd.conf's own Listen lines get commented
# out (see disable_main_conf_listen).
function write_patchy_conf() {
    local php_line=$1
    local php_guard="php_module"
    case "$php_line" in
        *php7_module*) php_guard="php7_module" ;;
    esac
    cat > "$PATCHY_CONF" <<EOF
# Managed by Patchy — do not edit.
# Rewritten in full by 'patchy setup' and 'patchy php <version>'.

Listen 80
Listen 443

<IfModule !socache_shmcb_module>
LoadModule socache_shmcb_module lib/httpd/modules/mod_socache_shmcb.so
</IfModule>
<IfModule !ssl_module>
LoadModule ssl_module lib/httpd/modules/mod_ssl.so
</IfModule>
<IfModule !rewrite_module>
LoadModule rewrite_module lib/httpd/modules/mod_rewrite.so
</IfModule>

$php_line

<IfModule dir_module>
    DirectoryIndex index.php index.html
</IfModule>

<IfModule $php_guard>
    <FilesMatch \.php\$>
        SetHandler application/x-httpd-php
    </FilesMatch>
</IfModule>

# Lets sites detect Patchy: \$_SERVER['PATCHY'] in PHP
<IfModule env_module>
    SetEnv PATCHY true
</IfModule>
EOF
    echo "Wrote $PATCHY_CONF"
}

# PHP LoadModule line for setup: keep whatever patchy.conf already has
# (setup must not undo a 'patchy php' switch); otherwise preserve whatever
# mod_php the existing httpd.conf still actively loads (a migration case);
# otherwise derive it from the currently linked PHP; otherwise fall back to
# the default 'php' formula. Both preservation branches skip a stale line
# whose module file no longer exists (e.g. the formula was uninstalled),
# so the next precedence step can self-heal it.
function detect_php_line() {
    local line
    line=$(grep -m1 '^LoadModule php' "$PATCHY_CONF" 2>/dev/null)
    if [ -n "$line" ] && [ -f "${line##* }" ]; then
        echo "$line"
        return 0
    fi
    # Migration case: preserve whatever mod_php the existing httpd.conf still
    # actively loads (detect runs before disable_main_conf_php comments it out)
    line=$(grep -m1 '^LoadModule php' "$APACHE_CONFIG" 2>/dev/null)
    if [ -n "$line" ] && [ -f "${line##* }" ]; then
        echo "$line"
        return 0
    fi
    local version
    version=$(php -n -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)
    if [ -n "$version" ]; then
        php_module_line "$version" "$(php_formula_for_version "$version")"
    else
        echo "LoadModule php_module $BREW_PREFIX/opt/php/lib/httpd/modules/libphp.so"
    fi
}

function run_setup() {
    echo "Configuring Patchy..."
    backup_config
    local backup="$LAST_BACKUP"

    set_apache_user
    mkdir -p "$VHOSTS_DIR" "$CERT_DIR" "$LOG_DIR"

    local php_line
    php_line=$(detect_php_line)
    local module_file="${php_line##* }"
    if [ ! -f "$module_file" ]; then
        echo "Warning: PHP module not found at $module_file"
    fi
    write_patchy_conf "$php_line"

    disable_main_conf_listen
    disable_main_conf_php
    ensure_sites_included
    ensure_patchy_included

    if ! apachectl -t; then
        echo "Apache config check failed — restoring httpd.conf from $backup"
        cp "$backup" "$APACHE_CONFIG"
        return 1
    fi

    setup_hosts || return 1

    echo "Patchy configured successfully. Backup of httpd.conf: $backup"
    echo "Run '$SCRIPT_NAME restart' to apply any changes."
    echo "Run '$SCRIPT_NAME help' to see available commands."
}

function set_apache_user() {
    local user
    user=$(whoami)
    echo "Setting Apache user to $user..."
    sed -i '' "s/^User .*/User $user/" "$APACHE_CONFIG"
    sed -i '' "s/^Group .*/Group $(id -gn)/" "$APACHE_CONFIG"
}

# Main script logic to handle different commands
case "${1:-}" in
    help)
        show_help
        ;;
    start)
        start_server
        ;;
    stop)
        if [ -n "${2:-}" ]; then
            echo "'stop' no longer takes options — DNS is managed via /etc/hosts automatically."
            exit 1
        fi
        stop_server
        ;;
    restart)
        restart_server
        ;;
    check)
        verify_config
        ;;
    refresh-certs)
        refresh_certs
        ;;
    ini)
        config_php
        ;;
    config)
        config_apache
        ;;
    setup)
        run_setup
        ;;
    trust)
        trust_patchy
        ;;
    untrust)
        untrust_patchy
        ;;
    list)
        echo "Sites configured on the Apache server..."
        echo ""
        list_sites
        ;;
    add)
        if [ -z "${2:-}" ]; then
            echo "Please provide a domain."
            exit 1
        fi
        add_site "$2" "${3:-}"
        ;;
    rm)
        if [ -z "${2:-}" ]; then
            echo "Please provide one or more domains."
            exit 1
        fi
        shift
        removed=0
        for domain in "$@"; do
            if remove_site "$domain"; then
                removed=1
            fi
        done
        if [ "$removed" -eq 1 ]; then
            restart_server
        fi
        ;;
    share)
        case "${2:-}" in
            "")
                echo "Please provide a domain."
                exit 1
                ;;
            setup)
                share_setup "${3:-}"
                ;;
            reset)
                share_reset
                ;;
            *)
                shift
                share_site "$@"
                ;;
        esac
        ;;
    errors)
        errors "${2:-20}"
        ;;
    logs)
        tail_logs
        ;;
    status)
        server_status
        ;;
    info)
        server_info
        echo ""
        php_info
        ;;
    version|--version|-v)
        echo "patchy $(patchy_version)"
        ;;
    php)
        switch_php_version "${2:-}"
        ;;
    pecl)
        install_pecl_extensions
        ;;
    *)
        echo "Invalid command!"
        show_help
        exit 1
        ;;
esac
