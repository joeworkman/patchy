#!/bin/zsh

# Patchy — a patchy little PHP dev server for macOS (running Apache)

set -uo pipefail

# Get the Homebrew installation prefix
BREW_PREFIX="$(brew --prefix)"
export BREW_PREFIX

# Define the directory for Apache virtual hosts
VHOSTS_DIR="$BREW_PREFIX/etc/httpd/sites"
export VHOSTS_DIR

# Define the Apache configuration file path
APACHE_CONFIG="$BREW_PREFIX/etc/httpd/httpd.conf"
export APACHE_CONFIG

# Define the directory for SSL certificates
CERT_DIR="$BREW_PREFIX/etc/httpd/certs"
export CERT_DIR

# Patchy-managed Apache include (rewritten in full by setup and php switch)
PATCHY_CONF="$BREW_PREFIX/etc/httpd/patchy.conf"
export PATCHY_CONF

# Apache log directory
LOG_DIR="$BREW_PREFIX/var/log/httpd"
export LOG_DIR

# Default parent directory for new site docroots
DEFAULT_WEBROOT="$HOME/Websites"

# Script name for help text (zsh's $0 resolves to function name inside functions)
SCRIPT_NAME="${0:t}"

# Resolved script path, captured at top level for the same $0 reason
SCRIPT_PATH="${0:A}"

# Patchy's commands live in libexec/, which sits beside bin/ both in a clone
# and in brew's Cellar. The list is explicit so a missing file fails loudly.
for module in output server hosts sites setup php share; do
    source "${SCRIPT_PATH:h:h}/libexec/$module.zsh" || exit 1
done
unset module

# Version is derived, never stored: brew runs from a versioned Cellar path;
# source installs report git describe from the clone
function patchy_version() {
    case "$SCRIPT_PATH" in
        */Cellar/patchy/*)
            local v="${SCRIPT_PATH#*/Cellar/patchy/}"
            echo "${v%%/*}"
            return 0
            ;;
    esac
    local gitv
    gitv=$(git -C "${SCRIPT_PATH:h}" describe --tags 2>/dev/null)
    if [ -n "$gitv" ]; then
        echo "${gitv#v}"
    else
        echo "dev"
    fi
}

# Function to display help message
function show_help() {
    cat <<EOF
Patchy v$(patchy_version) — a patchy little PHP dev server for macOS (running Apache)

Usage: $SCRIPT_NAME {command} [options]
       Add --json for machine-readable output (see the README for which commands).

Commands:
  help                  Show this help message

  list                  List the sites configured on the Apache server
  add <domain> [dir]    Add a new site (docroot defaults to ~/Websites/<domain>)
                        --yes skips the question asked before routing a real domain
                        --www / --no-www answer the www.<domain> question
  folder <domain> <dir> Serve a site from another folder
  rm <domain>...        Remove one or more sites with the specified domains

  status                Display the status of the Apache server and /etc/hosts routing
  start                 Start Apache and route site domains to this Mac (/etc/hosts)
  stop                  Stop Apache and release site domains back to public DNS
  restart               Restart the Apache server and repair /etc/hosts routing

  share <domain>        Share a site at a public link (uses cloudflared): your own
                        domain once set up, otherwise an anonymous link.
                        Options:
                          --temp              A random address on your domain, new each share
                          --anonymous         An anonymous trycloudflare.com link instead
                          --name <word>       Use <word>.<your domain> as the address
                          --auth [user:pass]  Require a password: a new one each share,
                                              or your own (default username: preview)
                                              user:pass is optional
  share setup <domain>  Use your own Cloudflare domain for stable share addresses
  share reset           Stop using your own domain; back to anonymous links

  config                Edit the Apache configuration file
  ini                   Edit the PHP configuration file
  check                 Verify the Apache and PHP configuration

  info                  Display Apache and PHP version information
  version               Display the Patchy version
  php <version>         Switch to the specified PHP version. Must be installed via Homebrew.
  pecl                  Install common PECL extensions (redis, apcu, imagick, yaml, pcov)
  refresh-certs         Refresh the SSL certificates

  setup                 One-time setup: Apache user, ports 80/443, modules, PHP handler, vhost include, DNS
  trust                 Let patchy update /etc/hosts without a sudo password
  untrust               Remove the passwordless /etc/hosts helper

  errors [lines|-f]     Display the last [lines] of the Apache error log (default 20), or -f to follow
  logs                  Tail the Apache logs
EOF
}

# Main script logic to handle different commands
# --yes, anywhere on the line, answers patchy's questions for you.
PATCHY_YES=0
if (( ${@[(Ie)--yes]} )); then
    PATCHY_YES=1
    set -- "${(@)@:#--yes}"
fi

# --www / --no-www answer add's question about also serving www.<domain>.
PATCHY_WWW=""
if [ "${1:-}" = add ]; then
    (( ${@[(Ie)--www]} )) && PATCHY_WWW=yes
    (( ${@[(Ie)--no-www]} )) && PATCHY_WWW=no
    set -- "${(@)${(@)@:#--www}:#--no-www}"
fi

# --json, anywhere on the line, gives machine-readable output on stdout: one
# JSON document for list, status and version, one event per line for share,
# and one result line ({"ok": ...}) for the commands that change things.
PATCHY_JSON=0
if (( ${@[(Ie)--json]} )); then
    PATCHY_JSON=1
    set -- "${(@)@:#--json}"
    if [[ ${1:-} != (list|status|version|info|check|errors|share|add|rm|folder|start|stop|restart|php|refresh-certs|trust|untrust) ||
          ( ${1:-} == share && ${2:-} == setup ) ]]; then
        command=${1:-}
        [ "$command" = share ] && command="share ${2:-}"
        json_doc -c --arg command "$command" '{ok: false, error: "json_unsupported",
            message: "--json does not work with \($command)", details: null, warnings: []}'
        exit 1
    fi
fi

case "${1:-}" in
    help)
        show_help
        ;;
    start)
        json_result start_server
        ;;
    stop)
        json_result stop_server "${2:-}"
        ;;
    restart)
        json_result restart_server
        ;;
    check)
        json_result check_config
        ;;
    refresh-certs)
        json_result refresh_certs
        ;;
    ini)
        config_php
        ;;
    config)
        config_apache
        ;;
    setup)
        run_setup
        ;;
    trust)
        json_result trust_patchy
        ;;
    untrust)
        json_result untrust_patchy
        ;;
    list)
        if [ "$PATCHY_JSON" -eq 1 ]; then
            list_sites_json
        else
            echo "Sites configured on the Apache server..."
            echo ""
            list_sites
        fi
        ;;
    add)
        json_result add_site "${2:-}" "${3:-}"
        ;;
    rm)
        shift
        json_result remove_sites "$@"
        ;;
    folder)
        json_result set_site_folder "${2:-}" "${3:-}"
        ;;
    share)
        case "${2:-}" in
            setup)
                share_setup "${3:-}"
                ;;
            reset)
                json_result share_reset
                ;;
            *)
                shift
                share_run "$@"
                ;;
        esac
        ;;
    errors)
        if [ "$PATCHY_JSON" -eq 1 ]; then
            errors_json "${2:-20}"
        else
            errors "${2:-20}"
        fi
        ;;
    logs)
        tail_logs
        ;;
    status)
        if [ "$PATCHY_JSON" -eq 1 ]; then
            server_status_json
        else
            server_status
        fi
        ;;
    info)
        if [ "$PATCHY_JSON" -eq 1 ]; then
            info_json
        else
            server_info
            echo ""
            php_info
        fi
        ;;
    version|--version|-v)
        if [ "$PATCHY_JSON" -eq 1 ]; then
            # features lets apps check what this patchy can do without
            # comparing version numbers.
            json_doc --arg version "$(patchy_version)" '{
                version: $version,
                features: ["json", "add_yes", "add_www", "folder", "askpass",
                    "share", "share_temp", "share_anonymous", "share_name", "share_auth"]
            }'
        else
            echo "patchy $(patchy_version)"
        fi
        ;;
    php)
        json_result switch_php_version "${2:-}"
        ;;
    pecl)
        install_pecl_extensions
        ;;
    *)
        echo "Invalid command!"
        show_help
        exit 1
        ;;
esac
