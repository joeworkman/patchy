#!/bin/zsh

# Patchy — a patchy little PHP dev server for macOS (running Apache)

set -uo pipefail

# Get the Homebrew installation prefix
BREW_PREFIX="$(brew --prefix)"
export BREW_PREFIX

# Define the directory for Apache virtual hosts
VHOSTS_DIR="$BREW_PREFIX/etc/httpd/sites"
export VHOSTS_DIR

# Define the Apache configuration file path
APACHE_CONFIG="$BREW_PREFIX/etc/httpd/httpd.conf"
export APACHE_CONFIG

# Define the directory for SSL certificates
CERT_DIR="$BREW_PREFIX/etc/httpd/certs"
export CERT_DIR

# Patchy-managed Apache include (rewritten in full by setup and php switch)
PATCHY_CONF="$BREW_PREFIX/etc/httpd/patchy.conf"
export PATCHY_CONF

# Apache log directory
LOG_DIR="$BREW_PREFIX/var/log/httpd"
export LOG_DIR

# Default parent directory for new site docroots
DEFAULT_WEBROOT="$HOME/Websites"

# dnsmasq answers wildcard *.tld lookups on an unprivileged port; macOS
# routes each TLD to it via /etc/resolver/<tld> (written once, with sudo)
DNSMASQ_PORT=53535
DNSMASQ_CONF="$BREW_PREFIX/etc/dnsmasq.conf"
DNSMASQ_DIR="$BREW_PREFIX/etc/dnsmasq.d"
PATCHY_DNS_CONF="$DNSMASQ_DIR/patchy.conf"
RESOLVER_DIR="/etc/resolver"

# Set when a command deletes a resolver file; finalize_dns_changes applies
# the matching dnsmasq-conf regeneration + restart + cache flush once.
DNS_DIRTY=0

# Script name for help text (zsh's $0 resolves to function name inside functions)
SCRIPT_NAME="${0:t}"

# Resolved script path, captured at top level for the same $0 reason
SCRIPT_PATH="${0:A}"

# Version is derived, never stored: brew runs from a versioned Cellar path;
# source installs report git describe from the clone
function patchy_version() {
    case "$SCRIPT_PATH" in
        */Cellar/patchy/*)
            local v="${SCRIPT_PATH#*/Cellar/patchy/}"
            echo "${v%%/*}"
            return 0
            ;;
    esac
    local gitv
    gitv=$(git -C "${SCRIPT_PATH:h}" describe --tags 2>/dev/null)
    if [ -n "$gitv" ]; then
        echo "${gitv#v}"
    else
        echo "dev"
    fi
}

# Path of the most recent httpd.conf backup (set by backup_config)
LAST_BACKUP=""

# Function to display help message
function show_help() {
    cat <<EOF
Patchy v$(patchy_version) — a patchy little PHP dev server for macOS (running Apache)

Usage: $SCRIPT_NAME {command} [options]

Commands:
  help                Show this help message

  list                List the sites configured on the Apache server
  add <domain> [dir]  Add a new site (docroot defaults to ~/Websites/<domain>)
  rm <domain>...      Remove one or more sites with the specified domains

  status              Display the status of the Apache and DNS servers
  start               Start the Apache and DNS servers
  stop                Stop Apache; DNS keeps running in pass-through mode
  stop dns            Stop the DNS server too (real-TLD sites go dark on this Mac)
  restart             Restart the Apache server (revives DNS serving if needed)

  config              Edit the Apache configuration file
  ini                 Edit the PHP configuration file
  check               Verify the Apache and PHP configuration

  info                Display Apache and PHP version information
  version             Display the Patchy version
  php <version>       Switch to the specified PHP version. You must have it installed via Homebrew.
  pecl                Install common PECL extensions (redis, apcu, imagick, yaml, pcov, memcached)
  refresh-certs       Refresh the SSL certificates

  setup               One-time setup: Apache user, ports 80/443, modules, PHP handler, vhost include, DNS

  errors [lines|-f]   Display the last [lines] of the Apache error log (default 20), or -f to follow
  logs                Tail the Apache logs
EOF
}

function start_server() {
    echo "Starting Apache server..."
    brew services start httpd
    start_dns
    if [ -n "$(list_local_domains)" ]; then
        local_sites_warning
        hosts_restore_all || echo "Warning: some .local hosts entries were not restored. Re-run '$SCRIPT_NAME start'." >&2
    fi
}

# "stop" leaves dnsmasq up in pass-through mode; "stop dns" shuts it down
# too, for when nothing should be running (uninstall, port conflicts).
function stop_server() {
    local mode="${1:-}"
    echo "Stopping Apache server..."
    brew services stop httpd
    if [ "$mode" = "dns" ]; then
        stop_dns_full
    else
        stop_dns
    fi
    if [ -n "$(list_local_domains)" ]; then
        local_sites_warning
        hosts_remove_all || echo "Warning: .local hosts entries were not removed; those names still resolve." >&2
    fi
}

function is_apache_running() {
    brew services info httpd --json | jq -e '.[0].running' >/dev/null 2>&1
}

function restart_server() {
    echo "Restarting Apache server..."
    brew services restart httpd
    ensure_dns_running
    # brew services returns 0 even if launchd fails to bring the process up.
    # Give it a moment and verify.
    local i
    for i in 1 2 3; do
        sleep 1
        is_apache_running && return 0
    done
    echo "Warning: Apache did not come back up after restart."
    echo "Run 'patchy errors' to see what went wrong."
    return 1
}

function dns_configured() {
    [ -f "$PATCHY_DNS_CONF" ]
}

function is_dnsmasq_running() {
    brew services info dnsmasq --json 2>/dev/null | jq -e '.[0].running' >/dev/null 2>&1
}

function start_dns() {
    if ! dns_configured; then
        echo "DNS is not configured — run '$SCRIPT_NAME setup'."
        return 0
    fi
    if dns_passthrough; then
        echo "Switching DNS back to serving local sites..."
        write_dns_conf
        restart_dns
        stale_dns_note
    else
        echo "Starting DNS server..."
        brew services start dnsmasq
    fi
    ensure_resolver_files
}

# Resolver files can vanish out from under us (a manual `sudo rm`, cleanup
# tools) and dnsmasq alone can't route anything without them — macOS would
# send those lookups straight to public DNS. start re-creates any that are
# missing, prompting for sudo only when something was actually deleted.
function ensure_resolver_files() {
    local name missing=()
    for name in test $(list_real_domains); do
        resolver_file_ok "$name" || missing+=("$name")
    done
    [ ${#missing[@]} -eq 0 ] && return 0
    if [ ! -t 0 ]; then
        echo "Warning: missing resolver file(s) for: ${(j:, :)missing} — those names" >&2
        echo "resolve via public DNS, not this Mac. Run '$SCRIPT_NAME setup' to restore." >&2
        return 0
    fi
    for name in "${missing[@]}"; do
        write_resolver_file "$name" || return 1
    done
    flush_dns_cache
}

# Stopping dnsmasq outright would leave the /etc/resolver files routing
# real-TLD domains to a dead port — macOS never falls back to public DNS
# when the listed nameserver is down, so a live site like example.com
# would be unreachable until its resolver file is deleted (sudo). Instead
# dnsmasq stays up in pass-through mode: no local answers, everything
# forwarded upstream, no password needed.
function stop_dns() {
    if ! dns_configured; then
        echo "DNS is not configured — run '$SCRIPT_NAME setup'."
        return 0
    fi
    echo "Switching DNS to pass-through mode (real domains resolve normally)..."
    write_dns_conf passthrough
    restart_dns
}

# Full DNS shutdown, explicitly requested via "stop dns". The resolver
# files stay behind routing their domains to the now-dead port, and macOS
# won't fall back to public DNS — warn exactly what goes dark.
function stop_dns_full() {
    if ! dns_configured; then
        echo "DNS is not configured — run '$SCRIPT_NAME setup'."
        return 0
    fi
    echo "Stopping DNS server..."
    brew services stop dnsmasq
    local name names=()
    for name in $(list_legacy_tlds); do
        names+=(".$name (entire TLD)")
    done
    for name in $(list_real_domains); do
        names+=("$name")
    done
    [ ${#names[@]} -eq 0 ] && return 0
    echo ""
    echo "Warning: with DNS stopped, these domains are unreachable on this Mac —"
    echo "including their live versions: ${(j:, :)names}"
    echo "Run '$SCRIPT_NAME start' to serve them locally again, or '$SCRIPT_NAME rm <domain>'"
    echo "to release a domain back to public DNS."
}

# macOS caches upstream answers fetched during pass-through with their
# original TTLs, so a real-TLD site can keep resolving to its production
# IP for a few minutes after start. Flushing needs sudo, so say how
# instead of prompting.
function stale_dns_note() {
    [ -n "$(list_real_domains)" ] || return 0
    echo "Note: if a real-TLD site still loads its production version, cached DNS"
    echo "answers may take a few minutes to expire. To clear them now, run:"
    echo "  sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"
}

function restart_dns() {
    echo "Restarting DNS server..."
    brew services restart dnsmasq
}

# DNS config changes restart dnsmasq at the point of change (ensure_dns_route,
# setup), so restart doesn't need to bounce it — but if dnsmasq died out
# from under us (e.g. a brew services reload denied by launchd), revive it,
# and if a stop left it in pass-through mode, put it back to serving.
function ensure_dns_running() {
    dns_configured || return 0
    if dns_passthrough; then
        echo "DNS is in pass-through mode — switching back to serving local sites..."
        write_dns_conf
        restart_dns
        stale_dns_note
        ensure_resolver_files
        return 0
    fi
    if ! is_dnsmasq_running; then
        echo "DNS server is not running — starting it..."
        brew services start dnsmasq
    fi
    ensure_resolver_files
}

# Rewrite the patchy-managed dnsmasq config in full. Serve mode (default):
# the .test wildcard always, one exact line per real-TLD site, and a
# TLD-wide wildcard for any lingering legacy /etc/resolver/<tld> file —
# as long as that file routes the whole TLD here, the conf must answer for
# it or every lookup under the TLD breaks. Pass-through mode answers
# nothing locally and forwards upstream via /etc/resolv.conf instead, so
# the /etc/resolver files (root-owned; deleting them needs sudo) keep
# pointing at a nameserver that returns real answers while patchy is
# stopped. Regeneration is also the teardown path — lines for removed
# sites simply aren't re-emitted. Port 53535 is unprivileged, so dnsmasq
# runs as the user — no sudo, no system daemon.
function write_dns_conf() {
    local mode="${1:-serve}"
    mkdir -p "$DNSMASQ_DIR"
    local domain tld
    {
        echo "# Managed by Patchy — do not edit."
        [ "$mode" = "passthrough" ] && echo "# mode: pass-through"
        echo ""
        echo "port=$DNSMASQ_PORT"
        echo "listen-address=127.0.0.1"
        echo "bind-interfaces"
        if [ "$mode" != "passthrough" ]; then
            echo "no-resolv"
            echo "address=/.test/127.0.0.1"
            for tld in $(list_legacy_tlds); do
                echo "address=/.$tld/127.0.0.1"
            done
            for domain in $(list_real_domains); do
                echo "address=/$domain/127.0.0.1"
            done
        fi
    } > "$PATCHY_DNS_CONF"
    echo "Wrote $PATCHY_DNS_CONF"
}

function dns_passthrough() {
    grep -qxF "# mode: pass-through" "$PATCHY_DNS_CONF" 2>/dev/null
}

# Pre-per-domain versions routed whole TLDs via /etc/resolver/<tld>; setup
# migrates these away, but one whose removal failed (sudo declined) still
# captures its entire TLD. The resolver dir is the source of truth: a
# single-label file on our port is a TLD-wide route. (.test is ours by
# design; .local is cleaned up by setup.)
function list_legacy_tlds() {
    local f name
    for f in "$RESOLVER_DIR"/*(N); do
        name="${f:t}"
        case "$name" in
            test|local|*.*) continue ;;
        esac
        resolver_file_ok "$name" && echo "$name"
    done
    return 0
}

# Homebrew's dnsmasq.conf ships with conf-dir commented out; enable it so
# dnsmasq picks up $PATCHY_DNS_CONF
function ensure_dnsmasq_confdir() {
    local line="conf-dir=$DNSMASQ_DIR/,*.conf"
    if [ -n "$(active_line_no "conf-dir=$DNSMASQ_DIR" "$DNSMASQ_CONF")" ]; then
        return 0
    fi
    echo "$line" >> "$DNSMASQ_CONF"
    echo "Enabled conf-dir in $DNSMASQ_CONF"
}

function write_resolver_file() {
    local name=$1
    echo "Configuring macOS to route $name lookups to Patchy (requires sudo)..."
    sudo mkdir -p "$RESOLVER_DIR" || return 1
    printf 'nameserver 127.0.0.1\nport %s\n' "$DNSMASQ_PORT" | sudo tee "$RESOLVER_DIR/$name" >/dev/null || return 1
}

# A resolver file only counts if it routes to our port — a stale file from
# another tool (e.g. Valet) would silently send lookups to the wrong port
function resolver_file_ok() {
    local name=$1
    grep -qE "^port[[:space:]]+$DNSMASQ_PORT\$" "$RESOLVER_DIR/$name" 2>/dev/null
}

# macOS caches DNS answers with their original TTLs; a routing change
# (resolver file added or removed) doesn't purge them, so a just-added
# domain can keep resolving to its live IP for minutes without this.
function flush_dns_cache() {
    echo "Flushing macOS DNS cache..."
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder
}

# Configured sites that need per-domain routing (everything except the
# .test wildcard and hosts-managed .local)
function list_real_domains() {
    local domain
    for domain in $(list_domains); do
        is_local_domain "$domain" && continue
        [ "${domain##*.}" = "test" ] && continue
        echo "$domain"
    done
    return 0
}

# Delete a per-domain resolver file if it's ours (never another tool's).
# Callers run this BEFORE touching anything else so a declined sudo aborts
# the whole removal cleanly.
function remove_resolver_file() {
    local domain=$1
    resolver_file_ok "$domain" || return 0
    echo "Removing $RESOLVER_DIR/$domain (requires sudo)..."
    sudo rm -f "$RESOLVER_DIR/$domain" || return 1
    DNS_DIRTY=1
}

# Once per command, not per domain: rebuild the dnsmasq conf from the
# surviving sites, bounce dnsmasq, drop stale macOS answers. Keeps the
# current mode so an rm while stopped doesn't flip DNS back to serving.
function finalize_dns_changes() {
    [ "$DNS_DIRTY" -eq 1 ] || return 0
    DNS_DIRTY=0
    if dns_passthrough; then
        write_dns_conf passthrough
    else
        write_dns_conf
    fi
    restart_dns
    flush_dns_cache
}

# .local sites live in /etc/hosts as exact names (Bonjour-safe): macOS
# reserves .local for mDNS, so a dnsmasq resolver file would hijack the
# whole TLD from device discovery. Entries carry a trailing "# patchy"
# marker so patchy can add/remove them without touching anything else.
function is_local_domain() {
    [ "${1##*.}" = "local" ]
}

function list_local_domains() {
    local domain
    for domain in $(list_domains); do
        is_local_domain "$domain" && echo "$domain"
    done
    return 0
}

function local_sites_warning() {
    echo "Password prompt ahead: these .local sites are managed via /etc/hosts,"
    echo "which needs sudo: $(list_local_domains | tr '\n' ' ')"
    echo "Moving them to .test (or another TLD) removes this prompt."
}

function hosts_entry_exists() {
    local escaped="${1//./\\.}"
    grep -qE "^127\.0\.0\.1[[:space:]]+${escaped}[[:space:]]*# patchy\$" /etc/hosts
}

function hosts_add_entry() {
    local domain=$1
    hosts_entry_exists "$domain" && return 0
    echo "127.0.0.1 $domain # patchy" | sudo tee -a /etc/hosts >/dev/null
}

function hosts_remove_entry() {
    local escaped="${1//./\\.}"
    hosts_entry_exists "$1" || return 0
    sudo sed -i '' -E "/^127\.0\.0\.1[[:space:]]+${escaped}[[:space:]]*# patchy\$/d" /etc/hosts
}

# stop: drop every patchy-marked entry in one edit
function hosts_remove_all() {
    grep -qF "# patchy" /etc/hosts || return 0
    sudo sed -i '' '/# patchy$/d' /etc/hosts
}

# start: regenerate marked entries for all configured .local sites
function hosts_restore_all() {
    local domain
    for domain in $(list_local_domains); do
        hosts_add_entry "$domain" || return 1
    done
}

function tld_configured() {
    local tld=$1
    resolver_file_ok "$tld" && grep -qF "address=/.$tld/" "$PATCHY_DNS_CONF" 2>/dev/null
}

# Per-domain analogue of tld_configured for real-TLD sites
function domain_routed() {
    local domain=$1
    resolver_file_ok "$domain" && grep -qF "address=/$domain/" "$PATCHY_DNS_CONF" 2>/dev/null
}

# add while stopped: the resolver file is written now (so sudo happens at
# add time, same as always) but the serve conf isn't touched — start
# regenerates it from the vhost list, picking this domain up.
function passthrough_route_note() {
    echo "DNS is in pass-through mode while the server is stopped; the domain"
    echo "will resolve to this Mac after '$SCRIPT_NAME start'."
}

# Route a domain's DNS before creating the site. .test rides a TLD-wide
# wildcard (one resolver file, ever); real TLDs get exact per-domain
# routing so the rest of the TLD stays on public DNS — a resolver file
# named for a domain captures that domain and its subdomains only.
# .local never reaches here (hosts-managed in add_site).
function ensure_dns_route() {
    local domain=$1
    local tld="${domain##*.}"

    if ! dns_configured; then
        echo "DNS is not configured — run '$SCRIPT_NAME setup' first."
        return 1
    fi

    if [ "$tld" = "test" ]; then
        tld_configured "test" && return 0
        if dns_passthrough; then
            if ! resolver_file_ok "test"; then
                write_resolver_file "test" || return 1
            fi
            passthrough_route_note
            return 0
        fi
        echo "Setting up DNS for .test domains..."
        echo "address=/.test/127.0.0.1" >> "$PATCHY_DNS_CONF"
        if ! write_resolver_file "test"; then
            sed -i '' '\|^address=/\.test/127\.0\.0\.1$|d' "$PATCHY_DNS_CONF"
            echo "DNS setup for .test was not completed." >&2
            return 1
        fi
        restart_dns
        flush_dns_cache
        return 0
    fi

    domain_routed "$domain" && return 0

    echo "Routing $domain (and subdomains) to this Mac. If $domain is a real"
    echo "website, it will be unreachable here until you run '$SCRIPT_NAME rm $domain'."
    printf "Continue? [y/N] "
    local reply
    read -r reply
    case "$reply" in
        y|Y|yes|YES) ;;
        *) echo "Aborted."; return 1 ;;
    esac

    if dns_passthrough; then
        if ! resolver_file_ok "$domain"; then
            write_resolver_file "$domain" || return 1
        fi
        passthrough_route_note
        return 0
    fi

    echo "Setting up DNS for $domain..."
    echo "address=/$domain/127.0.0.1" >> "$PATCHY_DNS_CONF"
    if ! write_resolver_file "$domain"; then
        local escaped="${domain//./\\.}"
        sed -i '' "\|^address=/$escaped/127\.0\.0\.1\$|d" "$PATCHY_DNS_CONF"
        echo "DNS setup for $domain was not completed." >&2
        return 1
    fi
    restart_dns
    flush_dns_cache
}

# Migrate hostess-era /etc/hosts entries. hostess consolidates every name
# onto one "127.0.0.1 localhost a b c…" line, so domains are matched as
# whitespace-delimited tokens and removed token-wise — never line-wise.
# .local sites are re-added as patchy-marked per-line entries (kept working;
# macOS reserves .local for Bonjour so dnsmasq can't serve them).
function migrate_hosts_entries() {
    local domain escaped stale=() locals=()
    local unmarked
    unmarked=$(grep -E '^[[:space:]]*127\.0\.0\.1[[:space:]]' /etc/hosts | grep -v '# patchy$')
    for domain in $(list_domains); do
        [ "$domain" = "localhost" ] && continue
        escaped="${domain//./\\.}"
        if echo "$unmarked" | grep -qE "[[:space:]]$escaped([[:space:]]|\$)"; then
            if is_local_domain "$domain"; then
                locals+=("$domain")
            else
                stale+=("$domain")
            fi
        fi
    done
    [ $(( ${#stale[@]} + ${#locals[@]} )) -eq 0 ] && return 0

    echo "Migrating /etc/hosts entries (requires sudo)..."
    echo "Backup: /etc/hosts.patchy-bkp"
    sudo cp /etc/hosts /etc/hosts.patchy-bkp || return 1

    local args=()
    for domain in "${stale[@]}" "${locals[@]}"; do
        escaped="${domain//./\\.}"
        args+=(-e "/^[[:space:]]*127\.0\.0\.1[[:space:]]/{" \
               -e "/# patchy\$/!s/[[:space:]]+($escaped)([[:space:]]|\$)/\\2/g" \
               -e "}")
    done
    sudo sed -i '' -E "${args[@]}" /etc/hosts || return 1

    local d
    for d in "${locals[@]}"; do
        hosts_add_entry "$d" || return 1
    done
}

function setup_dns() {
    if [ ! -t 0 ]; then
        echo "Skipping DNS configuration (no interactive terminal for sudo)."
        echo "Run '$SCRIPT_NAME setup' in a terminal to finish DNS setup."
        return 0
    fi

    if [ ! -d "$BREW_PREFIX/opt/dnsmasq" ]; then
        echo "dnsmasq is not installed. Install it with: brew install dnsmasq" >&2
        return 1
    fi

    echo "Configuring DNS (dnsmasq)..."

    # Migrate pre-per-domain TLD-wide routing: delete each legacy
    # /etc/resolver/<tld> file. One whose removal fails (sudo declined)
    # stays in list_legacy_tlds, so write_dns_conf below keeps answering
    # its wildcard — the conf never falls out of sync with what the
    # resolver files are actually routing.
    local tld
    for tld in $(list_legacy_tlds); do
        echo "Migrating .$tld from TLD-wide to per-domain routing..."
        if ! sudo rm -f "$RESOLVER_DIR/$tld"; then
            echo "Warning: could not remove $RESOLVER_DIR/$tld — DNS lookups for" >&2
            echo ".$tld would BREAK if the wildcard were dropped from the dnsmasq" >&2
            echo "config, so it's being kept for now. Re-run '$SCRIPT_NAME setup' to retry." >&2
        fi
    done

    ensure_dnsmasq_confdir
    write_dns_conf

    local name
    for name in test $(list_real_domains); do
        if ! resolver_file_ok "$name"; then
            write_resolver_file "$name" || return 1
        fi
    done

    # Pre-amendment versions wrote /etc/resolver/local, hijacking Bonjour.
    # Only remove it if it's ours (routes to our port).
    if resolver_file_ok "local"; then
        echo "Removing /etc/resolver/local (macOS reserves .local for Bonjour)..."
        sudo rm -f "$RESOLVER_DIR/local" || return 1
    fi

    migrate_hosts_entries || return 1

    echo "Starting DNS server..."
    brew services restart dnsmasq
    flush_dns_cache

    local i
    for i in 1 2 3; do
        sleep 1
        is_dnsmasq_running && return 0
    done
    echo "Warning: dnsmasq did not come up. Check: brew services info dnsmasq" >&2
    return 1
}

function open_in_editor() {
    local file=$1
    # Honor $VISUAL, then $EDITOR, falling back to `nano` (preinstalled on macOS).
    local editor="${VISUAL:-${EDITOR:-nano}}"
    if ! command -v "${editor%% *}" >/dev/null 2>&1; then
        echo "Editor '$editor' not found. Set \$VISUAL or \$EDITOR to your preferred editor." >&2
        return 1
    fi
    $editor "$file"
}

function config_apache() {
    echo "Editing configuration for Apache server..."
    echo "$APACHE_CONFIG"
    open_in_editor "$APACHE_CONFIG"
}

function config_php() {
    echo "Editing configuration for PHP..."
    local ini_file
    ini_file=$(php --ini | grep "Loaded Configuration File" | awk '{print $4}' | sed 's/"//g')
    echo "$ini_file"
    open_in_editor "$ini_file"
}

function tail_logs() {
    echo "Tailing logs for Apache server... $LOG_DIR"
    tail -f "$LOG_DIR"/*
}

function errors() {
    local arg=$1
    local log="$LOG_DIR/error_log"
    echo "Error log... $log"
    if [ "$arg" = "-f" ]; then
        tail -f "$log"
    else
        tail -n "$arg" "$log"
    fi
}

# Line number of the first ACTIVE (uncommented) line containing the needle
function active_line_no() {
    local needle=$1 file=$2
    grep -nF -- "$needle" "$file" 2>/dev/null | grep -vE '^[0-9]+:[[:space:]]*#' | head -n1 | cut -d: -f1
}

# Ensure httpd.conf wildcard-includes the per-site config directory.
# Strips any legacy per-site Include lines on first run.
function ensure_sites_included() {
    local include_line="IncludeOptional $VHOSTS_DIR/*.conf"
    local has_wildcard=0
    local has_legacy=0

    [ -n "$(active_line_no "$include_line" "$APACHE_CONFIG")" ] && has_wildcard=1
    grep -qF -- "Include $VHOSTS_DIR/" "$APACHE_CONFIG" && has_legacy=1

    if [ "$has_wildcard" -eq 1 ] && [ "$has_legacy" -eq 0 ]; then
        return 0
    fi

    backup_config

    if [ "$has_legacy" -eq 1 ]; then
        local tmp="$APACHE_CONFIG.tmp"
        grep -vF -- "Include $VHOSTS_DIR/" "$APACHE_CONFIG" > "$tmp"
        if [ -s "$tmp" ]; then
            mv "$tmp" "$APACHE_CONFIG"
        else
            rm -f "$tmp"
        fi
    fi

    if [ "$has_wildcard" -eq 0 ]; then
        echo "$include_line" >> "$APACHE_CONFIG"
        echo "Configured Apache to include sites from $VHOSTS_DIR"
    fi
}

# patchy.conf owns Listen — comment out httpd.conf's own Listen lines
# (duplicate Listen directives for the same port are a fatal startup error)
function disable_main_conf_listen() {
    if grep -q '^Listen ' "$APACHE_CONFIG"; then
        sed -i '' 's/^Listen /#Listen /' "$APACHE_CONFIG"
        echo "Commented out Listen lines in httpd.conf (now set in patchy.conf)"
    fi
}

# patchy.conf owns mod_php — comment out httpd.conf's LoadModule php lines,
# including duplicates accumulated by older 'patchy php' runs
function disable_main_conf_php() {
    if grep -q '^LoadModule php' "$APACHE_CONFIG"; then
        sed -i '' 's/^LoadModule php/#LoadModule php/' "$APACHE_CONFIG"
        echo "Commented out LoadModule php lines in httpd.conf (now set in patchy.conf)"
    fi
}

# Ensure httpd.conf includes patchy.conf BEFORE the per-site vhosts: Apache
# parses sequentially, and vhost directives like RewriteEngine error at parse
# time if their module loads later.
function ensure_patchy_included() {
    local include_line="Include $PATCHY_CONF"
    local sites_line="IncludeOptional $VHOSTS_DIR/*.conf"
    local inc_no sites_no
    inc_no=$(active_line_no "$include_line" "$APACHE_CONFIG")
    sites_no=$(active_line_no "$sites_line" "$APACHE_CONFIG")

    if [ -n "$inc_no" ] && { [ -z "$sites_no" ] || [ "$inc_no" -lt "$sites_no" ]; }; then
        return 0
    fi

    local tmp="$APACHE_CONFIG.tmp"
    if [ -n "$sites_no" ]; then
        grep -vF -- "$include_line" "$APACHE_CONFIG" | \
            awk -v inc="$include_line" -v sites="$sites_line" '
                { line = $0; sub(/^[[:space:]]+/, "", line) }
                index(line, sites) == 1 && !done { print inc; done = 1 }
                { print }
            ' > "$tmp"
    else
        grep -vF -- "$include_line" "$APACHE_CONFIG" > "$tmp"
        echo "$include_line" >> "$tmp"
    fi
    if [ -s "$tmp" ] && grep -qF -- "$include_line" "$tmp"; then
        mv "$tmp" "$APACHE_CONFIG"
        echo "Configured httpd.conf to include $PATCHY_CONF"
    else
        rm -f "$tmp"
        echo "Error: failed to update $APACHE_CONFIG; no changes made." >&2
        return 1
    fi
}

function add_site() {
    local domain=$1
    local docroot=${2:-}
    [ -z "$docroot" ] && docroot="$DEFAULT_WEBROOT/$domain"

    if site_exists "$domain"; then
        echo "Site already exists... $domain"
        return 1
    fi

    if [ ! -d "$docroot" ]; then
        echo "Creating document root at $docroot"
        mkdir -p "$docroot"
    fi

    docroot=$(cd "$docroot" && pwd)

    echo "Adding a new site... $domain"

    if is_local_domain "$domain"; then
        echo "Heads up: .local sites are managed via /etc/hosts because macOS"
        echo "reserves .local for Bonjour. This needs sudo now and on every"
        echo "'patchy start/stop'. Use .test instead to avoid password prompts."
        hosts_add_entry "$domain" || return 1
    else
        ensure_dns_route "$domain" || return 1
    fi

    echo "Creating SSL certificates..."
    make_cert "$domain"

    mkdir -p "$VHOSTS_DIR"
    ensure_sites_included

    echo "Creating Apache config file..."
    local conf_file="$VHOSTS_DIR/$domain.conf"
    cat > "$conf_file" <<EOF
<Directory "$docroot">
    Options Indexes FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

<VirtualHost *:80>
    DocumentRoot "$docroot"
    ServerName $domain
    ErrorLog "$LOG_DIR/$domain-error_log"
    CustomLog "$LOG_DIR/$domain-access_log" common
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^/?(.*) https://%{HTTP_HOST}/\$1 [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    DocumentRoot "$docroot"
    ServerName $domain
    ErrorLog "$LOG_DIR/$domain-error_log"
    CustomLog "$LOG_DIR/$domain-access_log" common
    SSLEngine on
    SSLCertificateFile "$CERT_DIR/$domain.pem"
    SSLCertificateKeyFile "$CERT_DIR/$domain-key.pem"
</VirtualHost>
EOF

    if ! verify_config; then
        echo "Rolling back site creation..."
        remove_domain "$domain"
        remove_cert "$domain"
        finalize_dns_changes
        return 1
    fi

    restart_server
    start_dns
}

function root_cert_exists() {
    local rootdir
    rootdir=$(mkcert -CAROOT)
    [ -f "$rootdir/rootCA.pem" ] && [ -f "$rootdir/rootCA-key.pem" ]
}

function make_cert() {
    local domain=$1
    mkdir -p "$CERT_DIR"
    cd "$CERT_DIR" || return 1
    if ! root_cert_exists; then
        mkcert -install
    fi
    mkcert "$domain"
}

function remove_root_certs() {
    mkcert -uninstall
    local rootdir
    rootdir=$(mkcert -CAROOT)
    rm -f "$rootdir/rootCA.pem" "$rootdir/rootCA-key.pem"
}

function remove_cert() {
    local domain=$1
    cd "$CERT_DIR" 2>/dev/null || return 0
    rm -f "$domain.pem" "$domain-key.pem"
}

function refresh_certs() {
    cd "$CERT_DIR" || return 1
    remove_root_certs
    make_cert localhost
    local site
    for site in $(list_domains); do
        [ "$site" = "localhost" ] && continue
        rm -f "$site.pem" "$site-key.pem"
        make_cert "$site"
    done
}

function cert_days_left() {
    local cert=$1 end_date end_epoch secs
    end_date=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null) || return 1
    end_date=${end_date#notAfter=}
    # %e not %d: openssl space-pads single-digit days ("Sep  9")
    end_epoch=$(date -j -f "%b %e %T %Y %Z" "$end_date" +%s 2>/dev/null) || return 1
    secs=$(( end_epoch - $(date +%s) ))
    echo $(( secs < 0 ? (secs - 86399) / 86400 : secs / 86400 ))
}

function list_domains() {
    [ -d "$VHOSTS_DIR" ] || return 0
    local f
    for f in "$VHOSTS_DIR"/*.conf(N); do
        echo "${f:t:r}"
    done | sort
}

function list_sites() {
    if [ ! -d "$VHOSTS_DIR" ] || [ -z "$(list_domains)" ]; then
        echo "No sites configured."
        return 0
    fi
    local domain docroot https days needs_attention=0
    local orange="" red="" reset=""
    if [ -t 1 ]; then
        orange=$'\e[38;5;208m'
        red=$'\e[31m'
        reset=$'\e[0m'
    fi
    local dwidth=6
    while IFS= read -r domain; do
        (( ${#domain} > dwidth )) && dwidth=${#domain}
    done < <(list_domains)
    (( dwidth += 3 ))
    printf "%-${dwidth}s %-8s %s\n" "DOMAIN" "HTTPS" "DOCROOT"
    while IFS= read -r domain; do
        docroot=$(sed -n 's/^[[:space:]]*DocumentRoot[[:space:]]*"\(.*\)".*/\1/p' "$VHOSTS_DIR/$domain.conf" | head -n1)
        docroot="${docroot/#$HOME/~}"
        local color=""
        if [ ! -f "$CERT_DIR/$domain.pem" ]; then
            https="no"
        elif ! days=$(cert_days_left "$CERT_DIR/$domain.pem"); then
            https="invalid"
            color=$red
            needs_attention=1
        elif [ "$days" -lt 0 ]; then
            https="expired"
            color=$red
            needs_attention=1
        elif [ "$days" -le 30 ]; then
            https="${days}d"
            color=$orange
            needs_attention=1
        else
            https="${days}d"
        fi
        # color applied outside the padding so escape codes don't skew column width
        printf "%-${dwidth}s ${color}%-8s${reset} %s\n" "$domain" "$https" "$docroot"
    done < <(list_domains)
    if [ "$needs_attention" -eq 1 ]; then
        echo ""
        echo "Some certificates expire soon or are invalid. Run 'patchy refresh-certs' to regenerate them."
    fi
}

function site_exists() {
    local domain=$1
    [ -f "$VHOSTS_DIR/$domain.conf" ]
}

function remove_site() {
    local domain=$1

    if ! site_exists "$domain"; then
        echo "Site does not exist... $domain"
        return 1
    fi

    remove_domain "$domain" || return 1
    remove_cert "$domain"
}

# Real-TLD DNS teardown runs FIRST: if sudo is declined the site is left
# fully intact rather than half-removed. (.test wildcards are never torn
# down by rm; .local rides /etc/hosts.)
function remove_domain() {
    local domain=$1

    if is_local_domain "$domain"; then
        echo "Removing /etc/hosts entry (requires sudo)..."
        hosts_remove_entry "$domain"
    elif [ "${domain##*.}" != "test" ]; then
        remove_resolver_file "$domain" || return 1
    fi

    echo "Removing Apache config file..."
    rm -f "$VHOSTS_DIR/$domain.conf"
}

function verify_config() {
    if apachectl -t; then
        echo "Apache configuration is valid."
    else
        echo "Apache configuration is invalid."
        return 1
    fi
    if php --ini >/dev/null; then
        echo "PHP configuration is valid."
    else
        echo "PHP configuration is invalid."
        return 1
    fi
}

function backup_config() {
    # Remove backups older than 30 days
    find "$BREW_PREFIX/etc/httpd" -name "httpd.conf.bkp-*" -mtime +30 -exec rm {} \;
    # Create a fresh backup, remembering the path for restore-on-failure
    LAST_BACKUP="$APACHE_CONFIG.bkp-$(date +%Y%m%d%H%M%S)"
    cp "$APACHE_CONFIG" "$LAST_BACKUP"
}

function server_status() {
    if is_apache_running; then
        echo "Apache: Running"
    else
        echo "Apache: Stopped"
    fi
    if ! dns_configured; then
        echo "DNS:    Not configured (run '$SCRIPT_NAME setup')"
    elif ! is_dnsmasq_running; then
        echo "DNS:    Stopped"
    elif dns_passthrough; then
        echo "DNS:    Pass-through (forwarding upstream; local sites not served)"
    else
        echo "DNS:    Running"
    fi
}

function server_info() {
    echo -e "\033[1mApache Server Info...\033[0m"
    apachectl -V | grep -E 'Server version|Server MPM|Server built'
}

function php_info() {
    echo -e "\033[1mPHP Version Info...\033[0m"
    php -v
}

# Resolve the Homebrew formula for a PHP version: "php" for the latest, "php@X.Y" otherwise
function php_formula_for_version() {
    local version=$1
    local php_formula="php@$version"
    local latest_version
    latest_version=$(brew info php --json=v2 2>/dev/null | jq -r '.formulae[0].versions.stable' | cut -d. -f1,2)
    if [ "$version" = "$latest_version" ]; then
        php_formula="php"
    fi
    echo "$php_formula"
}

# Build the Apache LoadModule line for a PHP version/formula
function php_module_line() {
    local version=$1
    local php_formula=$2
    local major_version="${version%%.*}"
    local module_path="$BREW_PREFIX/opt/$php_formula/lib/httpd/modules"
    if [ "$major_version" -ge 8 ]; then
        echo "LoadModule php_module $module_path/libphp.so"
    else
        echo "LoadModule php7_module $module_path/libphp7.so"
    fi
}

function switch_php_version() {
    if [ -z "${1:-}" ]; then
        echo "Please provide a PHP version (e.g., 7.4, 8.1, 8.2, 8.3, 8.4)"
        return 1
    fi

    local version=$1
    local php_formula
    php_formula=$(php_formula_for_version "$version")

    if ! brew list --formula 2>/dev/null | grep -E "^${php_formula}\$" >/dev/null; then
        echo "$php_formula is not installed."
        echo "Install it with: brew install $php_formula"
        return 1
    fi

    echo "Switching to PHP $version..."
    backup_config

    echo "Unlinking all PHP versions..."
    local formula
    for formula in $(brew list --formula | grep -E '^php(@[0-9.]+)?$'); do
        brew unlink "$formula" >/dev/null 2>&1 || true
    done

    echo "Linking PHP $version..."
    brew link --force --overwrite "$php_formula"

    echo "Updating Apache configuration..."

    local module_line
    module_line=$(php_module_line "$version" "$php_formula")
    if [ ! -f "${module_line##* }" ]; then
        echo "Warning: PHP module not found at ${module_line##* }"
    fi
    write_patchy_conf "$module_line"
    # Belt-and-suspenders for installs upgraded without re-running setup
    disable_main_conf_listen
    disable_main_conf_php
    ensure_sites_included
    ensure_patchy_included

    restart_server

    echo ""
    echo "PHP version switched to:"
    php -v | head -1
}

function install_pecl_extensions() {
    echo "Installing PECL extensions for current PHP version..."
    php -v | head -1
    echo ""

    echo "Installing required Homebrew dependencies..."
    brew install libyaml imagemagick libmemcached pkg-config zlib

    local pecl_ext_dir
    pecl_ext_dir=$(php -i | grep "^extension_dir" | head -1 | awk '{print $3}')
    echo "PECL extension directory: $pecl_ext_dir"

    if [ ! -d "$pecl_ext_dir" ]; then
        echo "Creating PECL directory: $pecl_ext_dir"
        mkdir -p "$pecl_ext_dir"
    fi

    local extensions=("redis" "apcu" "imagick" "yaml" "pcov" "memcached")
    local ext
    for ext in "${extensions[@]}"; do
        echo ""
        echo "Installing $ext..."
        case $ext in
            yaml)
                (echo "$(brew --prefix libyaml)"; yes "") | pecl install yaml || true
                ;;
            memcached)
                local zlib_dir
                zlib_dir=$(brew --prefix zlib)
                local libmemcached_dir
                libmemcached_dir=$(brew --prefix libmemcached)
                printf '%s\n' "$libmemcached_dir" "$zlib_dir" "no" "no" "no" "no" "no" "yes" "yes" | pecl install memcached || true
                ;;
            *)
                yes "" | pecl install "$ext" || true
                ;;
        esac
    done

    local ini_file
    ini_file=$(php -n -r "echo php_ini_loaded_file();" 2>/dev/null)
    if [ -z "$ini_file" ]; then
        ini_file="$BREW_PREFIX/etc/php/$(php -n -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')/php.ini"
    fi

    echo ""
    echo "Adding extensions to php.ini: $ini_file"

    for ext in "${extensions[@]}"; do
        if ! grep -qE "extension=.?${ext}(\.so)?.?$" "$ini_file"; then
            echo "extension=\"$ext.so\"" >> "$ini_file"
            echo "Added: extension=\"$ext.so\""
        else
            echo "Already configured: $ext"
        fi
    done

    echo ""
    echo "PECL extensions installed and configured."
}

# Rewrite the patchy-managed Apache include in full.
# <IfModule !…> guards avoid double-loading modules the user's httpd.conf
# already enables. Listen lives here exclusively: duplicate Listen directives
# are a fatal startup error, so httpd.conf's own Listen lines get commented
# out (see disable_main_conf_listen).
function write_patchy_conf() {
    local php_line=$1
    local php_guard="php_module"
    case "$php_line" in
        *php7_module*) php_guard="php7_module" ;;
    esac
    cat > "$PATCHY_CONF" <<EOF
# Managed by Patchy — do not edit.
# Rewritten in full by 'patchy setup' and 'patchy php <version>'.

Listen 80
Listen 443

<IfModule !socache_shmcb_module>
LoadModule socache_shmcb_module lib/httpd/modules/mod_socache_shmcb.so
</IfModule>
<IfModule !ssl_module>
LoadModule ssl_module lib/httpd/modules/mod_ssl.so
</IfModule>
<IfModule !rewrite_module>
LoadModule rewrite_module lib/httpd/modules/mod_rewrite.so
</IfModule>

$php_line

<IfModule dir_module>
    DirectoryIndex index.php index.html
</IfModule>

<IfModule $php_guard>
    <FilesMatch \.php\$>
        SetHandler application/x-httpd-php
    </FilesMatch>
</IfModule>

# Lets sites detect Patchy: \$_SERVER['PATCHY'] in PHP
<IfModule env_module>
    SetEnv PATCHY true
</IfModule>
EOF
    echo "Wrote $PATCHY_CONF"
}

# PHP LoadModule line for setup: keep whatever patchy.conf already has
# (setup must not undo a 'patchy php' switch); otherwise preserve whatever
# mod_php the existing httpd.conf still actively loads (a migration case);
# otherwise derive it from the currently linked PHP; otherwise fall back to
# the default 'php' formula. Both preservation branches skip a stale line
# whose module file no longer exists (e.g. the formula was uninstalled),
# so the next precedence step can self-heal it.
function detect_php_line() {
    local line
    line=$(grep -m1 '^LoadModule php' "$PATCHY_CONF" 2>/dev/null)
    if [ -n "$line" ] && [ -f "${line##* }" ]; then
        echo "$line"
        return 0
    fi
    # Migration case: preserve whatever mod_php the existing httpd.conf still
    # actively loads (detect runs before disable_main_conf_php comments it out)
    line=$(grep -m1 '^LoadModule php' "$APACHE_CONFIG" 2>/dev/null)
    if [ -n "$line" ] && [ -f "${line##* }" ]; then
        echo "$line"
        return 0
    fi
    local version
    version=$(php -n -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)
    if [ -n "$version" ]; then
        php_module_line "$version" "$(php_formula_for_version "$version")"
    else
        echo "LoadModule php_module $BREW_PREFIX/opt/php/lib/httpd/modules/libphp.so"
    fi
}

function run_setup() {
    if [ ! -d "$BREW_PREFIX/opt/dnsmasq" ]; then
        echo "dnsmasq is not installed. Install it with: brew install dnsmasq" >&2
        return 1
    fi

    echo "Configuring Patchy..."
    backup_config
    local backup="$LAST_BACKUP"

    set_apache_user
    mkdir -p "$VHOSTS_DIR" "$CERT_DIR" "$LOG_DIR"

    local php_line
    php_line=$(detect_php_line)
    local module_file="${php_line##* }"
    if [ ! -f "$module_file" ]; then
        echo "Warning: PHP module not found at $module_file"
    fi
    write_patchy_conf "$php_line"

    disable_main_conf_listen
    disable_main_conf_php
    ensure_sites_included
    ensure_patchy_included

    if ! apachectl -t; then
        echo "Apache config check failed — restoring httpd.conf from $backup"
        cp "$backup" "$APACHE_CONFIG"
        return 1
    fi

    setup_dns || return 1

    echo "Patchy configured successfully. Backup of httpd.conf: $backup"
    echo "Run '$SCRIPT_NAME restart' to apply any changes."
    echo "Run '$SCRIPT_NAME help' to see available commands."
}

function set_apache_user() {
    local user
    user=$(whoami)
    echo "Setting Apache user to $user..."
    sed -i '' "s/^User .*/User $user/" "$APACHE_CONFIG"
    sed -i '' "s/^Group .*/Group $(id -gn)/" "$APACHE_CONFIG"
}

# Main script logic to handle different commands
case "${1:-}" in
    help)
        show_help
        ;;
    start)
        start_server
        ;;
    stop)
        case "${2:-}" in
            "") stop_server ;;
            dns) stop_server dns ;;
            *)
                echo "Unknown stop option: $2 (did you mean '$SCRIPT_NAME stop dns'?)"
                exit 1
                ;;
        esac
        ;;
    restart)
        restart_server
        ;;
    check)
        verify_config
        ;;
    refresh-certs)
        refresh_certs
        ;;
    ini)
        config_php
        ;;
    config)
        config_apache
        ;;
    setup)
        run_setup
        ;;
    list)
        echo "Sites configured on the Apache server..."
        echo ""
        list_sites
        ;;
    add)
        if [ -z "${2:-}" ]; then
            echo "Please provide a domain."
            exit 1
        fi
        add_site "$2" "${3:-}"
        ;;
    rm)
        if [ -z "${2:-}" ]; then
            echo "Please provide one or more domains."
            exit 1
        fi
        shift
        removed=0
        for domain in "$@"; do
            if remove_site "$domain"; then
                removed=1
            fi
        done
        finalize_dns_changes
        if [ "$removed" -eq 1 ]; then
            restart_server
        fi
        ;;
    errors)
        errors "${2:-20}"
        ;;
    logs)
        tail_logs
        ;;
    status)
        server_status
        ;;
    info)
        server_info
        echo ""
        php_info
        ;;
    version|--version|-v)
        echo "patchy $(patchy_version)"
        ;;
    php)
        switch_php_version "${2:-}"
        ;;
    pecl)
        install_pecl_extensions
        ;;
    *)
        echo "Invalid command!"
        show_help
        exit 1
        ;;
esac
